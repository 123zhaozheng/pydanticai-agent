n).lower()\\n    if any(keyword in reason for keyword in [\'卡死\', \'崩溃\', \'无法\', \'失效\', \'致命\']):\\n        return \'高\'\\n    elif any(keyword in reason for keyword in [\'缺陷\', \'问题\', \'bug\', \'错误\', \'异常\']):\\n        return \'中\'\\n    elif any(keyword in reason for keyword in [\'优化\', \'改进\', \'提示\', \'建议\']):\\n        return \'低\'\\n    else:\\n        return \'中\'\\n\\ndf[\'严重程度\'] = df[\'问题原因\'].apply(assess_severity)\\n\\nprint(\\"\\\\n📊 执行摘要\\")\\nprint(\\"-\\" * 50)\\n\\n# 基础统计\\ntotal_problems = len(df)\\nwith_status = df[\'状态\'].notna().sum()\\nsolved = (df[\'状态\'] == \'已解决\').sum()\\nin_progress = (df[\'状态\'] == \'在处理\').sum()\\n\\nprint(f\\"📈 总体概况:\\")\\nprint(f\\"   • 总问题数: {total_problems} 个\\")\\nprint(f\\"   • 已解决: {solved} 个 ({solved/with_status*100:.1f}%)\\")\\nprint(f\\"   • 在处理: {in_progress} 个 ({in_progress/with_status*100:.1f}%)\\")\\nprint(f\\"   • 状态完整率: {with_status/total_problems*100:.1f}%\\")\\n\\n# 问题类型分析\\ncategory_counts = df[\'问题分类\'].value_counts()\\nprint(f\\"\\\\n🎯 问题类型分布:\\")\\nfor i, (category, count) in enumerate(category_counts.items(), 1):\\n    print(f\\"   {i}. {category}: {count} 个问题 ({count/total_problems*100:.1f}%)\\")\\n\\n# 时间分析\\nvalid_time_diffs = df[\'时间差(天)\'].dropna()\\nif len(valid_time_diffs) > 0:\\n    avg_time_diff = valid_time_diffs.mean()\\n    on_time_count = (valid_time_diffs <= 0).sum()\\n    delayed_count = (valid_time_diffs > 0).sum()\\n    \\n    print(f\\"\\\\n⏰ 时间效率分析:\\")\\n    print(f\\"   • 平均时间差: {avg_time_diff:+.1f} 天\\")\\n    print(f\\"   • 按时完成率: {on_time_count/len(valid_time_diffs)*100:.1f}%\\")\\n    print(f\\"   • 延迟完成率: {delayed_count/len(valid_time_diffs)*100:.1f}%\\")\\n\\n# 数据质量评估\\ndata_completeness = {\\n    \'状态\': df[\'状态\'].notna().sum() / len(df) * 100,\\n    \'计划时间\': df[\'计划时间\'].notna().sum() / len(df) * 100,\\n    \'实际解决时间\': df[\'实际解决时间\'].notna().sum() / len(df) * 100,\\n    \'措施\': df[\'措施\'].notna().sum() / len(df) * 100\\n}\\n\\nprint(f\\"\\\\n📋 数据质量评估:\\")\\nfor f