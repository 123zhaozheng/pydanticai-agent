ds = {word: count for word, count in word_counts.items() \\n                         if len(word) > 1 and count > 1}\\n        \\n        print(f\'\\\\n5. 问题关键词统计 (出现次数>1):\')\\n        sorted_words = sorted(filtered_words.items(), key=lambda x: x[1], reverse=True)\\n        for word, count in sorted_words[:20]:\\n            print(f\'{word}: {count}次\')\\n        \\n        # 6. 解决状态分析\\n        if \'问题解决状态\' in df_clean.columns:\\n            status_counts = df_clean[\'问题解决状态\'].value_counts()\\n            print(f\'\\\\n6. 问题解决状态分布:\')\\n            print(status_counts)\\n        \\n        # 保存分析结果\\n        with open(\'/workspace/intermediate/analysis_results.txt\', \'w\', encoding=\'utf-8\') as f:\\n            f.write(\\"Excel数据分析报告\\\\n\\")\\n            f.write(\\"=\\"*50 + \\"\\\\n\\\\n\\")\\n            f.write(f\\"数据总行数: {len(df)}\\\\n\\")\\n            f.write(f\\"有效问题数: {len(df_clean)}\\\\n\\")\\n            f.write(f\\"提问人数: {unique_users}\\\\n\\\\n\\")\\n            \\n            f.write(\\"2. 提问最多的用户:\\\\n\\")\\n            f.write(user_counts.to_string())\\n            f.write(\\"\\\\n\\\\n\\")\\n            \\n            if \'问题类型\' in df_clean.columns:\\n                f.write(\\"3. 问题类型分布:\\\\n\\")\\n                f.write(type_counts.to_string())\\n                f.write(\\"\\\\n\\\\n\\")\\n            \\n            f.write(\\"4. 关键词分析:\\\\n\\")\\n            for word, count in sorted_words[:15]:\\n                f.write(f\\"{word}: {count}次\\\\n\\")\\n            f.write(\\"\\\\n\\")\\n        \\n        print(\'\\\\n分析结果已保存到 /workspace/intermediate/analysis_results.txt\')\\n        \\n    else:\\n        print(\'没有找到有效的原始问题数据\')\\n        \\nexcept Exception as e:\\n    print(\'读取文件时出错:\', e)"}', tool_call_id='call_7d478b5c52e24ba6b3938b04'))
