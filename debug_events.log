2025-12-29 13:59:16.710320 Event: <class 'pydantic_ai.messages.PartStartEvent'> PartStartEvent(index=2, part=ToolCallPart(tool_name='write_file', args='{"path":"/workspace/intermediate/problem_reason_analysis_fixed.py","content":"import pandas as pd\\nimport numpy as np\\nimport matplotlib.pyplot as plt\\nimport seaborn as sns\\nfrom datetime import datetime\\nimport re\\nfrom collections import Counter\\nimport warnings\\nwarnings.filterwarnings(\'ignore\')\\n\\n# 设置中文字体支持\\nplt.rcParams[\'font.sans-serif\'] = [\'SimHei\', \'Microsoft YaHei\']\\nplt.rcParams[\'axes.unicode_minus\'] = False\\n\\n# 读取数据\\ndf = pd.read_excel(\'/workspace/uploads/昆小智问题处理计划.xlsx\')\\n\\nprint(\\"=\\" * 60)\\nprint(\\"昆小智问题处理计划 - 问题原因分布和频率分析\\")\\nprint(\\"=\\" * 60)\\n\\n# 1. 基础问题原因统计\\nprint(\\"\\\\n1. 基础问题原因统计:\\")\\nprint(f\\"总问题数: {len(df)}\\")\\nprint(f\\"唯一问题原因数: {df[\'问题原因\'].nunique()}\\")\\n\\nprint(\\"\\\\n问题原因列表:\\")\\nfor i, reason in enumerate(df[\'问题原因\'].unique(), 1):\\n    print(f\\"{i:2d}. {reason}\\")\\n\\n# 2. 问题原因频次分析\\nprint(\\"\\\\n2. 问题原因频次分析:\\")\\nreason_counts = df[\'问题原因\'].value_counts()\\nprint(\\"\\\\n问题原因频次统计:\\")\\nfor i, (reason, count) in enumerate(reason_counts.items(), 1):\\n    print(f\\"{i:2d}. {reason}: {count} 次\\")\\n\\n# 3. 问题原因分类分析\\nprint(\\"\\\\n3. 问题原因分类分析:\\")\\n\\ndef categorize_problem_reason(reason):\\n    \\"\\"\\"对问题原因进行分类\\"\\"\\"\\n    reason = str(reason).lower()\\n    \\n    if any(keyword in reason for keyword in [\'浏览器\', \'客户端\', \'版本\']):\\n        return \'客户端问题\'\\n    elif any(keyword in reason for keyword in [\'模型\', \'思考\', \'glm4\', \'deepseek\', \'qwen\']):\\n        return \'模型问题\'\\n    elif any(keyword in reason for keyword in [\'应用\', \'bug\', \'缺陷\', \'优化\', \'前端\']):\\n        return \'应用缺陷\'\\n    elif any(keyword in reason for keyword in [\'知识库\', \'知识\', \'敏感信息\', \'清理\']):\\n        return \'知识库问题\'\\n    elif any(keyword in reason for keyword in [\'提示词\', \'回复\', \'交互\']):\\n        return \'交互体验\'\\n    elif any(keyword in reason for keyword in [\'登录\', \'密码\']):\\n        return \'认证问题\'\\n    else:\\n        return \'其他问题\'\\n\\n# 添加分类列\\ndf[\'问题分类\'] = df[\'问题原因\'].apply(categorize_problem_reason)\\n\\nprint(\\"\\\\n问题分类统计:\\")\\ncategory_counts = df[\'问题分类\'].value_counts()\\nfor i, (category, count) in enumerate(category_counts.items(), 1):\\n    print(f\\"{i:2d}. {category}: {count} 个问题 ({count/len(df)*100:.1f}%)\\")\\n\\n# 4. 创建分类饼图\\nplt.figure(figsize=(10, 8))\\ncolors = plt.cm.Set3(np.linspace(0, 1, len(category_counts)))\\nwedges, texts, autotexts = plt.pie(category_counts.values, \\n                                   labels=category_counts.index, \\n                                   autopct=\'%1.1f%%\',\\n                                   colors=colors,\\n                                   startangle=90)\\n\\n# 设置文字样式\\nfor autotext in autotexts:\\n    autotext.set_color(\'white\')\\n    autotext.set_fontweight(\'bold\')\\n\\nplt.title(\'问题类型分布\', fontsize=16, fontweight=\'bold\', pad=20)\\nplt.axis(\'equal\')\\nplt.tight_layout()\\nplt.savefig(\'/workspace/intermediate/problem_categories.png\', dpi=300, bbox_inches=\'tight\')\\nplt.close()\\nprint(\\"问题分类饼图已保存至: /workspace/intermediate/problem_categories.png\\")\\n\\n# 5. 创建问题原因条形图\\nplt.figure(figsize=(14, 8))\\nreason_counts_sorted = reason_counts.sort_values(ascending=True)\\nbars = plt.barh(range(len(reason_counts_sorted)), reason_counts_sorted.values)\\nplt.yticks(range(len(reason_counts_sorted)), reason_counts_sorted.index)\\nplt.xlabel(\'问题频次\')\\nplt.title(\'问题原因频次分布\', fontsize=16, fontweight=\'bold\')\\nplt.grid(axis=\'x\', alpha=0.3)\\n\\n# 添加数值标签\\nfor i, (bar, count) in enumerate(zip(bars, reason_counts_sorted.values)):\\n    plt.text(bar.get_width() + 0.1, bar.get_y() + bar.get_height()/2, \\n             str(count), va=\'center\', fontweight=\'bold\')\\n\\nplt.tight_layout()\\nplt.savefig(\'/workspace/intermediate/problem_reasons_detailed.png\', dpi=300, bbox_inches=\'tight\')\\nplt.close()\\nprint(\\"详细问题原因条形图已保存至: /workspace/intermediate/problem_reasons_detailed.png\\")\\n\\n# 6. 关键词分析\\nprint(\\"\\\\n4. 关键词分析:\\")\\n\\n# 提取所有问题原因中的关键词\\nall_reasons = \' \'.join(df[\'问题原因\'].astype(str).tolist())\\n# 使用正则表达式提取中文关键词\\nchinese_keywords = re.findall(r\'[\\\\u4e00-\\\\u9fff]+\', all_reasons)\\nkeyword_counts = Counter(chinese_keywords)\\n\\n# 过滤掉单个字符的常见词\\nfiltered_keywords = {k: v for k, v in keyword_counts.items() \\n                     if len(k) >= 2 and v > 1}\\n\\nprint(\\"\\\\n高频关键词统计:\\")\\nsorted_keywords = sorted(filtered_keywords.items(), key=lambda x: x[1], reverse=True)\\nfor i, (keyword, count) in enumerate(sorted_keywords, 1):\\n    print(f\\"{i:2d}. \'{keyword}\': {count} 次\\")\\n\\n# 7. 严重程度评估\\nprint(\\"\\\\n5. 问题严重程度评估:\\")\\n\\ndef assess_severity(reason):\\n    \\"\\"\\"评估问题严重程度\\"\\"\\"\\n    reason = str(reason).lower()\\n    \\n    # 高严重程度\\n    if any(keyword in reason for keyword in [\'卡死\', \'崩溃\', \'无法\', \'失效\', \'致命\']):\\n        return \'高\'\\n    # 中等严重程度\\n    elif any(keyword in reason for keyword in [\'缺陷\', \'问题\', \'bug\', \'错误\', \'异常\']):\\n        return \'中\'\\n    # 低严重程度\\n    elif any(keyword in reason for keyword in [\'优化\', \'改进\', \'提示\', \'建议\']):\\n        return \'低\'\\n    else:\\n        return \'中\'  # 默认中等\\n\\n# 添加严重程度列\\ndf[\'严重程度\'] = df[\'问题原因\'].apply(assess_severity)\\n\\nprint(\\"\\\\n问题严重程度分布:\\")\\nseverity_counts = df[\'严重程度\'].value_counts()\\nfor i, (severity, count) in enumerate(severity_counts.items(), 1):\\n    print(f\\"{i:2d}. {severity}级: {count} 个问题 ({count/len(df)*100:.1f}%)\\")\\n\\n# 8. 创建严重程度图表\\nplt.figure(figsize=(10, 6))\\nseverity_order = [\'高\', \'中\', \'低\']\\nax = sns.countplot(data=df, x=\'严重程度\', order=severity_order, palette=[\'red\', \'orange\', \'green\'])\\nplt.title(\'问题严重程度分布\', fontsize=16, fontweight=\'bold\')\\nplt.xlabel(\'严重程度\')\\nplt.ylabel(\'问题数量\')\\n\\n# 添加数值标签\\nfor i, bar in enumerate(ax.patches):\\n    height = bar.get_height()\\n    ax.text(bar.get_x() + bar.get_width()/2., height + 0.1,\\n            f\'{int(height)}\', ha=\'center\', va=\'bottom\', fontweight=\'bold\')\\n\\nplt.tight_layout()\\nplt.savefig(\'/workspace/intermediate/problem_severity.png\', dpi=300, bbox_inches=\'tight\')\\nplt.close()\\nprint(\\"问题严重程度图表已保存至: /workspace/intermediate/problem_severity.png\\")\\n\\n# 9. 按分类的严重程度交叉分析\\nprint(\\"\\\\n6. 按分类的严重程度交叉分析:\\")\\nseverity_by_category = pd.crosstab(df[\'问题分类\'], df[\'严重程度\'], margins=True)\\nprint(severity_by_category)\\n\\n# 10. 问题总结和建议\\nprint(\\"\\\\n7. 问题总结和建议:\\")\\nprint(\\"\\\\n主要发现:\\")\\nprint(f\\"1. 共发现 {len(df)} 个问题，涉及 {df[\'问题分类\'].nunique()} 个主要类别\\")\\nprint(f\\"2. 最常见的问题类型是: {category_counts.index[0]} ({category_counts.iloc[0]} 个问题)\\")\\nprint(f\\"3. 高频问题关键词包括: {\', \'.join([k for k, v in sorted_keywords[:3]]) if sorted_keywords else \'无\'}\\")\\nprint(f\\"4. 严重程度分布: 高严重程度 {severity_counts.get(\'高\', 0)} 个, 中严重程度 {severity_counts.get(\'中\', 0)} 个, 低严重程度 {severity_counts.get(\'低\', 0)} 个\\")\\n\\nprint(\\"\\\\n建议:\\")\\nprint(\\"1. 优先解决高严重程度的问题，特别是系统崩溃类问题\\")\\nprint(\\"2. 针对高频问题类型制定标准化解决方案\\")\\nprint(\\"3. 建立问题预防机制，减少同类问题的重复发生\\")\\nprint(\\"4. 加强知识库管理和优化，提高回答准确性\\")\\n\\nprint(\\"\\\\n\\" + \\"=\\" * 60)\\nprint(\\"问题原因分布和频率分析完成！\\")\\nprint(\\"=\\" * 60)"}', tool_call_id='call_f68b0f9d9dcf4b52a5f040ae'), previous_part_kind='text')
