y_score += data_completeness * 0.3\\n    \\n    print(f\\"\\\\n综合处理效率评分: {efficiency_score:.1f}/100\\")\\n\\n# 4. 创建状态分布可视化图表\\nprint(\\"\\\\n4. 创建状态分布可视化图表:\\")\\n\\n# 图表1: 状态分布饼图\\nplt.figure(figsize=(15, 10))\\n\\nif \'状态\' in df.columns:\\n    # 原始状态数据\\n    plt.subplot(2, 3, 1)\\n    status_data = df[\'状态\'].dropna()\\n    if len(status_data) > 0:\\n        status_counts = status_data.value_counts()\\n        colors = plt.cm.Set3(np.linspace(0, 1, len(status_counts)))\\n        wedges, texts, autotexts = plt.pie(status_counts.values, \\n                                         labels=status_counts.index, \\n                                         autopct=\'%1.1f%%\',\\n                                         colors=colors,\\n                                         startangle=90)\\n        for autotext in autotexts:\\n            autotext.set_color(\'white\')\\n            autotext.set_fontweight(\'bold\')\\n        plt.title(\'问题状态分布\', fontsize=12, fontweight=\'bold\')\\n\\n    # 图表2: 问题分类与状态的关系\\n    plt.subplot(2, 3, 2)\\n    if len(df) > 0:\\n        category_status_data = df.dropna(subset=[\'问题分类\', \'状态\'])\\n        if len(category_status_data) > 0:\\n            # 创建堆叠柱状图\\n            category_status_pivot = pd.crosstab(category_status_data[\'问题分类\'], \\n                                               category_status_data[\'状态\'])\\n            \\n            # 计算百分比\\n            category_status_pct = category_status_pivot.div(category_status_pivot.sum(axis=1), axis=0)\\n            \\n            category_status_pct.plot(kind=\'bar\', stacked=True, ax=plt.gca())\\n            plt.title(\'问题分类状态分布(%)\', fontsize=12, fontweight=\'bold\')\\n            plt.xlabel(\'问题分类\')\\n            plt.ylabel(\'占比\')\\n            plt.xticks(rotation=45, ha=\'right\')\\n            plt.legend(title=\'状态\')\\n            plt.grid(True, alpha=0.3)\\n\\n    # 图表3: 状态严重程度矩阵\\n    plt.subplot(2, 3, 3)\\n    \\n    def assess_severity(reason):\\n        \\"\\"\\"评估问题严重程度\\"\\"\\"\\n        reason = str(reason).lower()\\n        if any(keyword in reason for keyword in [\'卡死\', \'崩溃\', \'无法\', \'失效\', \'致命\']):\\n            return \'高\'\\n        elif any(keyword in reason for keyword in [\'缺陷\', \'问题\', \'bug\', \'错误\', \'异常\']):\\n            return \'中\'\\n        elif any(keyword in reason for keyword in [\'优化\', \'改进\', \'提示\', \'建议\']):\\n            return \'低\'\\n        else:\\n            return \'中\'\\n\\n    df[\'严重程度\'] = df[\'问题原因\'].apply(assess_severity)\\n    \\n    # 状态与严重程度的关系\\n    status_severity_data = df.dropna(subset=[\'状态\', \'严重程度\'])\\n    if len(status_severity_data) > 0:\\n        severity_status_matrix = pd.crosstab(status_severity_data[\'严重程度\'], \\n                                           status_severity_data[\'状态\'])\\n        \\n        # 热力图\\n        sns.heatmap(severity_status_matrix, annot=True, fmt=\'d\', cmap=\'YlOrRd\', \\n                   cbar_kws={\'label\': \'问题数量\'})\\n        plt.title(\'状态-严重程度矩阵\', fontsize=12, fontweight=\'bold\')\\n        plt.xlabel(\'状态\')\\n        plt.ylabel(\'严重程度\')\\n\\n    # 图表4: 问题分类饼图\\n    plt.subplot(2, 3, 4)\\n    category_counts = df[\'问题分类\'].value_counts()\\n    colors = plt.cm.Pastel1(np.linspace(0, 1, len(category_counts)))\\n    wedges, texts, autotexts = plt.pie(category_counts.values, \\n                                     labels=category_counts.index, \\n                                     autopct=\'%1.1f%%\',\\n                                     colors=colors,\\n                                     startangle=90)\\n    for autotext in autotexts:\\n        autotext.set_color(\'black\')\\n        autotext.set_fontweight(\'bold\')\\n    plt.title(\'问题类型分布\', fontsize=12, fontweight=\'bold\')\\n\\n    # 图表5: 处理效率雷达图\\n    plt.subplot(2, 3, 5, projection=\'polar\')\\n    \\n    # 计算各个维度的指标\\n    metrics = []\\n    labels = []\\n    \\n    # 解决率\\n    if with_status > 0:\\n        metrics.append(solution_rate / 100)\\n        labels.append(\'解决率\')\\n    \\n    # 时间效率（如果有的话）\\n    if \'时间差(天)\' in df.columns:\\n        time_data = df.dropna(subset=[\'时间差(天)\'])\\n        if len(time_data) > 0:\\n            on_time_rate = (time_data[\'时间差(天)\'] <= 0).sum() / len(time_data)\\n            metrics.append(on_time_rate)\\n            labels.append(\'时间效率\')\\n    \\n    # 数据完整性\\n    data_completeness_metric = with_status / total_problems\\n    metrics.append(data_completeness_metric)\\n    labels.append(\'数据完整性\')\\n    \\n    # 绘制雷达图\\n    if len(metrics) > 0:\\n        angles = np.linspace(0, 2 * np.pi, len(metrics), endpoint=False).tolist()\\n        metrics += metrics[:1]  # 闭合图形\\n        angles += angles[:1]\\n        \\n        ax = plt.gca()\\n        ax.plot(angles, metrics, \'o-\', linewidth=2, color=\'blue\')\\n        ax.fill(angles, metrics, alpha=0.25, color=\'blue\')\\n        ax.set_xticks(angles[:-1])\\n        ax.set_xticklabels(labels)\\n        ax.set_ylim(0, 1)\\n        ax.set_title(\'处理效率雷达图\', fontsize=12, fontweight=\'bold\')\\n\\n    # 图表6: 状态进度条\\n    plt.subplot(2, 3, 6)\\n    \\n    # 创建进度条\\n    categories = [\'总问题\', \'有状态\', \'已解决\', \'在处理\', \'无状态\']\\n    values = [total_problems, with_status, solved, in_progress, no_status]\\n    max_val = max(values)\\n    \\n    bars = plt.bar(categories, values, color=[\'blue\', \'green\', \'lightgreen\', \'orange\', \'gray\'])\\n    plt.ylabel(\'问题数量\')\\n    plt.title(\'问题状态统计\', fontsize=12, fontweight=\'bold\')\\n    plt.xticks(rotation=45, ha=\'right\')\\n    \\n    # 添加数值标签\\n    for bar, value in zip(bars, values):\\n        plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.1,\\n                str(value), ha=\'center\', va=\'bottom\', fontweight=\'bold\')\\n\\nplt.tight_layout()\\nplt.savefig(\'/workspace/intermediate/status_distribution_analysis.png\', dpi=300, bbox_inches=\'tight\')\\nplt.close()\\nprint(\\"状态分布分析图表已保存至: /workspace/intermediate/status_distribution_analysis.png\\")\\n\\n# 5. 未解决问题分析\\nprint(\\"\\