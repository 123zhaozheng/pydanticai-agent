n    for type_name, count in 连锁品牌类型.items():\\n        print(f\\"  {type_name}: {count} 家\\")\\n    \\n    # 统计重复企业\\n    print(f\\"\\\\n=== 重复企业分析 ===\\")\\n    all_companies = pd.concat([连锁品牌_clean[\'企业名称\'], 板块商户_clean[\'企业名称\']])\\n    duplicates = all_companies[all_companies.duplicated(keep=False)]\\n    print(f\\"总重复企业数量: {len(duplicates)}\\")\\n    \\n    # 分析备注情况\\n    print(\\"\\\\n=== 备注分析 ===\\")\\n    连锁品牌备注 = 连锁品牌_clean[\'备注\'].dropna()\\n    板块商户备注 = 板块商户_clean[\'备注\'].dropna()\\n    print(f\\"连锁品牌有备注的记录数: {len(连锁品牌备注)}\\")\\n    print(f\\"板块商户有备注的记录数: {len(板块商户备注)}\\")\\n    \\n    # 分析备注内容\\n    if len(连锁品牌备注) > 0:\\n        print(\\"连锁品牌备注内容:\\")\\n        备注_counter = Counter(连锁品牌备注)\\n        for note, count in 备注_counter.items():\\n            print(f\\"  \'{note}\': {count} 次\\")\\n    \\n    if len(板块商户备注) > 0:\\n        print(\\"板块商户备注内容:\\")\\n        备注_counter = Counter(板块商户备注)\\n        for note, count in 备注_counter.items():\\n            print(f\\"  \'{note}\': {count} 次\\")\\n    \\n    # 返回清理后的数据供后续使用\\n    return 连锁品牌_clean, 板块商户_clean\\n\\nif __name__ == \\"__main__\\":\\n    连锁品牌, 板块商户 = analyze_data()"}', tool_call_id='call_0f4ad4a46fcc47838a910150'))
