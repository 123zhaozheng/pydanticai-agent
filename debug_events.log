tGroup\n\nfor i := 0; i < 5; i++ {\n    wg.Add(1)\n    go func(n int) {\n        defer wg.Done()\n        fmt.Println("Worker", n)\n    }(i)\n}\n\nwg.Wait() // 等待所有goroutine完成\n```\n\n## Python 异步实现\n\n### 1. asyncio 模块\n\nPython 的异步编程主要基于 `asyncio` 模块。\n\n#### 基本异步函数\n\n```python\nimport asyncio\nimport aiohttp\n\n# 定义异步函数\nasync def fetch_data(url):\n    async with aiohttp.ClientSession() as session:\n        async with session.get(url) as response:\n            return await response.text()\n\n# 运行异步函数\nasync def main():\n    urls = [\n        \'http://httpbin.org/delay/1\',\n        \'http://httpbin.org/delay/1\',\n        \'http://httpbin.org/delay/1\'\n    ]\n    \n    # 并发执行\n    tasks = [fetch_data(url) for url in urls]\n    results = await asyncio.gather(*tasks)\n    \n    for result in results:\n        print(f"Fetched {len(result)} characters")\n\n# 运行事件循环\nasyncio.run(main())\n```\n\n#### 异步生成器\n\n```python\nasync def async_range(start, end):\n    for i in range(start, end):\n        yield i\n        await asyncio.sleep(0.1)\n\nasync def main():\n    async for num in async_range(1, 5):\n        print(num)\n```\n\n### 2. 事件循环和任务管理\n\n#### Task 和 Future\n\n```python\nimport asyncio\n\nasync def slow_operation(n):\n    await asyncio.sleep(n)\n    return f"Operation {n} completed"\n\nasync def main():\n    # 创建任务\n    task1 = asyncio.create_task(slow_operation(1))\n    task2 = asyncio.create_task(slow_operation(2))\n    \n    # 等待所有任务完成\n    result1 = await task1\n    result2 = await task2\n    \n    print(result1, result2)\n\nasyncio.run(main())\n```\n\n#### 并发执行\n\n```python\nimport asyncio\n\nasync def fetch_url(session, url):\n    async with session.get(url) as response:\n        return await response.text()\n\nasync def main():\n    urls = [\n        \'http://httpbin.org/delay/1\',\n        \'http://httpbin.org/delay/1\',\n        \'http://httpbin.org/delay/1\'\n    ]\n    \n    async with aiohttp.ClientSession() as session:\n        # 并发请求\n        tasks = [fetch_url(session, url) for url in urls]\n        results = await asyncio.gather(*tasks)\n        \n        for result in results:\n            print(f"Fetched {len(result)} characters")\n\nasyncio.run(main())\n```\n\n### 3. 异步上下文管理器\n\n```python\nimport asyncio\n\nclass AsyncContextManager:\n    async def __aenter__(self):\n        print("Entering context")\n        return self\n    \n    async def __aexit__(self, exc_type, exc_val, exc_tb):\n        print("Exiting context")\n    \n    async def do_work(self):\n        await asyncio.sleep(1)\n        return "Work done"\n\nasync def main():\n    async with AsyncContextManager() as cm:\n        result = await cm.do_work()\n        print(result)\n\nasyncio.run(main())\n```\n\n## 两者对比\n\n### 1. 实现原理\n\n| 特性 | Go | Python |\n|------|----|--------|\n| 并发模型 | Goroutine + Channel | asyncio + Event Loop |\n| 调度方式 | M:N 模型（M个OS线程，N个Goroutine） | 单线程事件循环 |\n| 内存开销 | 极低（通常2KB） | 相对较高 |\n| 调度器 | 运行时调度 | 用户态调度 |\n\n### 2. 性能特点\n\n#### Go 的优势：\n- **轻量级**：Goroutine 开销极小，可以轻松创建百万级协程\n- **高效调度**：Go 运行时智能调度，减少上下文切换\n- **内置并发**：语言层面原生支持并发\n\n#### Python 的优势：\n- **生态丰富**：大量异步库（aiohttp, aiomysql等）\n- **易于理解**：基于协程的概念更容易上手\n- **兼容性好**：与现有同步代码兼容性好\n\n### 3. 代码示例对比\n\n#### 并发HTTP请求\n\n**Go 版本：**\n```go\npackage main\n\nimport (\n    "fmt"\n    "net/http"\n    "sync"\n    "time"\n)\n\nfunc fetchURL(url string, wg *sync.WaitGroup, results chan<- string) {\n    defer wg.Done()\n    start := time.Now()\n    resp, err := http.Get(url)\n    if err != nil {\n        results <- fmt.Sprintf("Error: %v", err)\n        return\n    }\n    defer resp.Body.Close()\n    duration := time.Since(start)\n    results <- fmt.Sprintf("Fetched %s in %v", url, duration)\n}\n\nfunc main() {\n    urls := []string{\n        "http://httpbin.org/delay/1",\n        "http://httpbin.org/delay/1",\n        "http://httpbin.org/delay/1",\n    }\n    \n    var wg sync.WaitGroup\n    results := make(chan string, len(urls))\n    \n    for _, url := range urls {\n        wg.Add(1)\n        go fetchURL(url, &wg, results)\n    }\n    \n    go func() {\n        wg.Wait()\n        close(results)\n    }()\n    \n    for result := range results {\n        fmt.Println(result)\n    }\n}\n```\n\n**Python 版本：**\n```python\nimport asyncio\nimport aiohttp\nimport time\n\nasync def fetch_url(session, url):\n    start = time.time()\n    try:\n        async with session.get(url) as response:\n            await response.text()\n            duration = time.time() - start\n            return f"Fetched {url} in {duration:.2f}s"\n    except Exception as e:\n        return f"Error: {e}"\n\nasync def main():\n    urls = [\n        \'http://httpbin.org/delay/1\',\n        \'http://httpbin.org/delay/1\',\n        \'http://httpbin.org/delay/1\'\n    ]\n    \n    async with aiohttp.ClientSession() as session:\n        tasks = [fetch_url(session, url) for url in urls]\n        results = await asyncio.gather(*tasks)\n        \n        for result in results:\n            print(result)\n\nasyncio.run(main())\n```\n\n### 4. 适用场景\n\n#### Go 适合：\n- 高并发网络服务\n- 微服务架构\n- 实时系统\n- 需要大量轻量级并发的场景\n\n#### Python 适合：\n- Web 应用开发\n- 数据处理和分析\n- 与现有同步代码集成\n- 快速原型开发\n\n### 5. 最佳实践\n\n#### Go：\n```go\n// 使用 context 控制超时\nctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\ndefer cancel()\n\n// 使用 Worker Pool 模式\nfunc workerPool(jobs <-chan Job, results chan<- Result, numWorkers int) {\n    var wg sync.WaitGroup\n    for i := 0; i < numWorkers; i++ {\n        wg.Add(1)\n        go func() {\n            defer wg.Done()\n            for job := range jobs {\n                // 处理任务\n                results <- process(job)\n            }\n        }()\n    }\n    wg.Wait()\n}\n```\n\n#### Python：\n```python\n# 使用 asyncio.Semaphore 控制并发数\nsemaphore = asyncio.Semaphore(10)  # 最多10个并发\n\nasync def limited_fetch(session, url):\n    async with semaphore:\n        async with session.get(url) as response:\n            return await response.text()\n\n# 使用 asyncio.as_completed 处理完成的任务\nasync def process_urls(urls):\n    async with aiohttp.ClientSession() as session:\n        tasks = [limited_fetch(session, url) for url in urls]\n        for coro in asyncio.as_completed(tasks):\n            result = await coro\n            print(f"Completed: {result}")\n```\n\n总的来说，Go 和 Python 的异步实现各有特色，Go 更注重性能和轻量级并发，而 Python 更注重易用性和生态系统。选择哪种语言主要取决于具体的项目需求和团队技术栈。'))
