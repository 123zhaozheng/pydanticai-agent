2025-12-29 11:06:26.044738 Event: <class 'pydantic_ai.messages.PartStartEvent'> PartStartEvent(index=2, part=ToolCallPart(tool_name='write_file', args='{"path":"/workspace/intermediate/timing_efficiency_analysis.py","content":"import pandas as pd\\nimport numpy as np\\nfrom datetime import datetime, timedelta\\n\\n# 设置文件路径\\nfile_path = \'/workspace/uploads/昆小智问题处理计划.xlsx\'\\n\\n# 读取数据\\ndf = pd.read_excel(file_path, sheet_name=\'Sheet1\')\\n\\nprint(\\"=== 处理时效性分析（计划vs实际解决时间）===\\\\n\\")\\n\\n# 1. 数据预处理\\nprint(\\"1. 数据预处理:\\")\\nprint(f\\"总记录数: {len(df)}\\")\\n\\n# 清理时间格式，转换为标准datetime\\ndef clean_time_format(time_str):\\n    if pd.isna(time_str):\\n        return None\\n    try:\\n        # 尝试不同的日期格式\\n        if isinstance(time_str, str):\\n            time_str = time_str.strip()\\n            # 处理 \\"2025.11.06\\" 格式\\n            if time_str.count(\'.\') == 2:\\n                return pd.to_datetime(time_str, format=\'%Y.%m.%d\')\\n            # 处理其他格式\\n            else:\\n                return pd.to_datetime(time_str)\\n        else:\\n            return pd.to_datetime(time_str)\\n    except:\\n        return None\\n\\n# 处理时间列\\ndf[\'计划时间\'] = df[\'计划时间\'].apply(clean_time_format)\\ndf[\'实际解决时间\'] = df[\'实际解决时间\'].apply(clean_time_format)\\n\\nprint(f\\"计划时间有效值: {df[\'计划时间\'].notna().sum()}个\\")\\nprint(f\\"实际解决时间有效值: {df[\'实际解决时间\'].notna().sum()}个\\")\\n\\n# 2. 基础时效分析\\nprint(f\\"\\\\n2. 基础时效分析:\\")\\n\\n# 计算处理时间（仅对完整记录）\\ncomplete_records = df.dropna(subset=[\'计划时间\', \'实际解决时间\'])\\nprint(f\\"完整记录数（计划时间+实际解决时间都存在）: {len(complete_records)}\\")\\n\\n# 计算处理延迟\\ndef calculate_delay(plan_time, actual_time):\\n    if pd.isna(plan_time) or pd.isna(actual_time):\\n        return None\\n    return (actual_time - plan_time).days\\n\\ncomplete_records[\'处理延迟天数\'] = complete_records.apply(\\n    lambda row: calculate_delay(row[\'计划时间\'], row[\'实际解决时间\']), axis=1\\n)\\n\\n# 处理延迟统计\\nif len(complete_records) > 0:\\n    delays = complete_records[\'处理延迟天数\'].dropna()\\n    if len(delays) > 0:\\n        print(f\\"\\\\n处理延迟统计:\\")\\n        print(f\\"  平均延迟: {delays.mean():.1f}天\\")\\n        print(f\\"  中位数延迟: {delays.median():.1f}天\\")\\n        print(f\\"  最小延迟: {delays.min()}天\\")\\n        print(f\\"  最大延迟: {delays.max()}天\\")\\n        print(f\\"  标准差: {delays.std():.1f}天\\")\\n\\n        # 延迟分布\\n        on_time = len([d for d in delays if d == 0])\\n        early = len([d for d in delays if d < 0])\\n        delayed = len([d for d in delays if d > 0])\\n        \\n        print(f\\"\\\\n  按时完成: {on_time}个 ({on_time/len(delays)*100:.1f}%)\\")\\n        print(f\\"  提前完成: {early}个 ({early/len(delays)*100:.1f}%)\\")\\n        print(f\\"  延迟完成: {delayed}个 ({delayed/len(delays)*100:.1f}%)\\")\\n    else:\\n        print(\\"没有可用的延迟数据\\")\\nelse:\\n    print(\\"没有完整的时间记录用于计算延迟\\")\\n\\n# 3. 时间趋势分析\\nprint(f\\"\\\\n3. 时间趋势分析:\\")\\n\\n# 按计划时间排序\\ncomplete_records_sorted = complete_records.sort_values(\'计划时间\')\\nif len(complete_records_sorted) > 0:\\n    print(f\\"\\\\n按计划时间排序的处理记录:\\")\\n    for idx, row in complete_records_sorted.iterrows():\\n        delay = row[\'处理延迟天数\']\\n        status = f\\"延迟{delay}天\\" if delay > 0 else f\\"提前{-delay}天\\" if delay < 0 else \\"按时\\"\\n        print(f\\"  计划时间: {row[\'计划时间\'].strftime(\'%Y-%m-%d\')} - \\"\\n              f\\"实际解决: {row[\'实际解决时间\'].strftime(\'%Y-%m-%d\')} - \\"\\n              f\\"状态: {status}\\")\\n\\n# 4. 处理效率分析\\nprint(f\\"\\\\n4. 处理效率分析:\\")\\n\\n# 分析不同类型问题的处理时间\\ndef analyze_efficiency_by_type():\\n    if len(complete_records) == 0:\\n        print(\\"没有足够数据进行分析\\")\\n        return\\n\\n    # 添加问题类型分类\\n    def get_problem_type(reason):\\n        reason = str(reason).lower()\\n        if \'浏览器\' in reason:\\n            return \'浏览器问题\'\\n        elif \'模型\' in reason:\\n            return \'模型问题\'\\n        elif \'应用缺陷\' in reason:\\n            return \'应用缺陷\'\\n        elif \'知识库\' in reason:\\n            return \'知识库问题\'\\n        elif \'登录\' in reason:\\n            return \'登录问题\'\\n        else:\\n            return \'其他问题\'\\n\\n    complete_records[\'问题类型\'] = complete_records[\'问题原因\'].apply(get_problem_type)\\n\\n    # 按类型分析处理效率\\n    print(f\\"\\\\n各问题类型处理效率:\\")\\n    type_efficiency = complete_records.groupby(\'问题类型\').agg({\\n        \'处理延迟天数\': [\'count\', \'mean\', \'median\', \'std\']\\n    }).round(1)\\n\\n    for problem_type in complete_records[\'问题类型\'].unique():\\n        type_data = complete_records[complete_records[\'问题类型\'] == problem_type]\\n        if len(type_data) > 0:\\n            avg_delay = type_data[\'处理延迟天数\'].mean()\\n            print(f\\"  {problem_type}: {len(type_data)}个问题, 平均延迟 {avg_delay:.1f}天\\")\\n\\n# 5. 时间完成率分析\\nprint(f\\"\\\\n5. 时间完成率分析:\\")\\n\\n# 计划时间完成率\\nplan_completeness = df[\'计划时间\'].notna().sum() / len(df) * 100\\nactual_completeness = df[\'实际解决时间\'].notna().sum() / len(df) * 100\\n\\nprint(f\\"计划时间记录完整率: {plan_completeness:.1f}%\\")\\nprint(f\\"实际解决时间记录完整率: {actual_completeness:.1f}%\\")\\n\\n# 6. 处理时效分布\\nprint(f\\"\\\\n6. 处理时效分布:\\")\\n\\n# 统计不同时间段的记录\\ntime_data = {\\n    \'有计划时间\': df[\'计划时间\'].notna().sum(),\\n    \'无计划时间\': df[\'计划时间\'].isna().sum(),\\n    \'有实际解决时间\': df[\'实际解决时间\'].notna().sum(),\\n    \'无实际解决时间\': df[\'实际解决时间\'].isna().sum(),\\n    \'时间都完整\': df.dropna(subset=[\'计划时间\', \'实际解决时间\']).shape[0],\\n    \'时间都缺失\': df[df[\'计划时间\'].isna() & df[\'实际解决时间\'].isna()].shape[0]\\n}\\n\\nfor category, count in time_data.items():\\n    percentage = count / len(df) * 100\\n    print(f\\"  {category}: {count}个 ({percentage:.1f}%)\\")\\n\\n# 7. 预测性分析\\nprint(f\\"\\\\n7. 预测性分析:\\")\\n\\nif len(complete_records) > 0:\\n    # 计算平均处理周期\\n    avg_processing_time = complete_records[\'处理延迟天数\'].mean()\\n    \\n    print(f\\"基于历史数据的处理时效预测:\\")\\n    print(f\\"  平均处理周期: {avg_processing_time:.1f}天\\")\\n    \\n    if avg_processing_time <= 0:\\n        print(\\"  总体表现: 优秀，平均提前完成\\")\\n    elif avg_processing_time <= 1:\\n        print(\\"  总体表现: 良好，平均延迟不超过1天\\")\\n    elif a