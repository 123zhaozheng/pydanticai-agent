2025-12-30 16:14:22.685871 Event: <class 'pydantic_ai.messages.FunctionToolResultEvent'> FunctionToolResultEvent(result=ToolReturnPart(tool_name='read_file', content='     1\t#!/bin/bash\n     2\t\n     3\t# =============================================================================\n     4\t# Linux系统运行状态查询脚本 (完整版)\n     5\t# 该脚本用于收集和显示Linux系统的各种运行状态信息\n     6\t# =============================================================================\n     7\t\n     8\t# 颜色定义\n     9\tRED=\'\\033[0;31m\'\n    10\tGREEN=\'\\033[0;32m\'\n    11\tYELLOW=\'\\033[1;33m\'\n    12\tBLUE=\'\\033[0;34m\'\n    13\tNC=\'\\033[0m\' # No Color\n    14\t\n    15\t# 错误处理函数\n    16\terror_exit() {\n    17\t    echo -e "${RED}错误: $1${NC}" >&2\n    18\t    exit 1\n    19\t}\n    20\t\n    21\t# 显示帮助信息\n    22\tshow_help() {\n    23\t    echo "用法: $0 [选项]"\n    24\t    echo "选项:"\n    25\t    echo "  -h, --help     显示此帮助信息"\n    26\t    echo "  -v, --verbose  显示详细输出"\n    27\t    echo "  -q, --quiet    只显示基本信息"\n    28\t    echo ""\n    29\t    echo "示例:"\n    30\t    echo "  $0              # 显示完整信息"\n    31\t    echo "  $0 -q           # 只显示基本信息"\n    32\t    echo "  $0 --help       # 显示帮助信息"\n    33\t}\n    34\t\n    35\t# 显示标题函数\n    36\tshow_title() {\n    37\t    echo -e "${BLUE}========================================${NC}"\n    38\t    echo -e "${BLUE}        Linux系统运行状态查询工具${NC}"\n    39\t    echo -e "${BLUE}========================================${NC}"\n    40\t    echo\n    41\t}\n    42\t\n    43\t# 1. 系统基本信息\n    44\tget_system_info() {\n    45\t    echo -e "${GREEN}1. 系统基本信息${NC}"\n    46\t    echo "----------------"\n    47\t    \n    48\t    # 获取内核版本\n    49\t    if command -v uname >/dev/null 2>&1; then\n    50\t        kernel_version=$(uname -r)\n    51\t        echo "内核版本: $kernel_version"\n    52\t    fi\n    53\t    \n    54\t    # 获取系统发行版信息\n    55\t    if [ -f /etc/os-release ]; then\n    56\t        . /etc/os-release\n    57\t        echo "系统发行版: $NAME $VERSION"\n    58\t    elif [ -f /etc/debian_version ]; then\n    59\t        echo "系统发行版: Debian $(cat /etc/debian_version)"\n    60\t    else\n    61\t        echo "系统发行版: 未知"\n    62\t    fi\n    63\t    \n    64\t    # 获取主机名\n    65\t    if command -v hostname >/dev/null 2>&1; then\n    66\t        hostname=$(hostname)\n    67\t        echo "主机名: $hostname"\n    68\t    fi\n    69\t    \n    70\t    # 获取架构信息\n    71\t    if command -v uname >/dev/null 2>&1; then\n    72\t        architecture=$(uname -m)\n    73\t        echo "系统架构: $architecture"\n    74\t    fi\n    75\t    \n    76\t    echo\n    77\t}\n    78\t\n    79\t# 2. CPU使用情况\n    80\tget_cpu_info() {\n    81\t    echo -e "${GREEN}2. CPU使用情况${NC}"\n    82\t    echo "----------------"\n    83\t    \n    84\t    # CPU核心数\n    85\t    if command -v nproc >/dev/null 2>&1; then\n    86\t        cpu_cores=$(nproc)\n    87\t        echo "CPU核心数: $cpu_cores"\n    88\t    fi\n    89\t    \n    90\t    # CPU型号\n    91\t    if [ -f /proc/cpuinfo ] && command -v grep >/dev/null 2>&1; then\n    92\t        cpu_model=$(grep \'model name\' /proc/cpuinfo | head -1 | cut -d\':\' -f2 | sed \'s/^[[:space:]]*//\')\n    93\t        if [ -n "$cpu_model" ]; then\n    94\t            echo "CPU型号: $cpu_model"\n    95\t        fi\n    96\t    fi\n    97\t    \n    98\t    echo\n    99\t}\n   100\t\n   101\t# 3. 内存使用情况\n   102\tget_memory_info() {\n   103\t    echo -e "${GREEN}3. 内存使用情况${NC}"\n   104\t    echo "----------------"\n   105\t    \n   106\t    # 使用free命令获取内存信息\n   107\t    if command -v free >/dev/null 2>&1; then\n   108\t        echo "内存使用详情:"\n   109\t        free -h\n   110\t    else\n   111\t        # 从/proc/meminfo获取信息作为备选方案\n   112\t        if [ -f /proc/meminfo ]; then\n   113\t            echo "内存使用详情 (从/proc/meminfo):"\n   114\t            mem_total=$(grep MemTotal /proc/meminfo | awk \'{print $2}\')\n   115\t            mem_free=$(grep MemFree /proc/meminfo | awk \'{print $2}\')\n   116\t            mem_available=$(grep MemAvailable /proc/meminfo | awk \'{print $2}\')\n   117\t            \n   118\t            # 转换为MB显示（简单整除）\n   119\t            if [ -n "$mem_total" ] && [ "$mem_total" -gt 0 ]; then\n   120\t                mem_total_mb=$((mem_total / 1024))\n   121\t                echo "总内存: ${mem_total_mb} MB"\n   122\t            fi\n   123\t            \n   124\t            if [ -n "$mem_free" ] && [ "$mem_free" -gt 0 ]; then\n   125\t                mem_free_mb=$((mem_free / 1024))\n   126\t                echo "空闲内存: ${mem_free_mb} MB"\n   127\t            fi\n   128\t            \n   129\t            if [ -n "$mem_available" ] && [ "$mem_available" -gt 0 ]; then\n   130\t                mem_available_mb=$((mem_available / 1024))\n   131\t                echo "可用内存: ${mem_available_mb} MB"\n   132\t            fi\n   133\t        fi\n   134\t    fi\n   135\t    \n   136\t    echo\n   137\t}\n   138\t\n   139\t# 4. 磁盘空间使用情况\n   140\tget_disk_info() {\n   141\t    echo -e "${GREEN}4. 磁盘空间使用情况${NC}"\n   142\t    echo "----------------"\n   143\t    \n   144\t    # 使用df命令获取磁盘空间信息\n   145\t    if command -v df >/dev/null 2>&1; then\n   146\t        echo "磁盘空间使用情况:"\n   147\t        df -h\n   148\t    else\n   149\t        echo "无法获取磁盘信息 (df命令不可用)"\n   150\t    fi\n   151\t    \n   152\t    echo\n   153\t}\n   154\t\n   155\t# 5. 系统负载\n   156\tget_load_info() {\n   157\t    echo -e "${GREEN}5. 系统负载${NC}"\n   158\t    echo "----------------"\n   159\t    \n   160\t    # 获取系统负载\n   161\t    if command -v uptime >/dev/null 2>&1; then\n   162\t        load_avg=$(uptime 2>/dev/null)\n   163\t        if [ -n "$load_avg" ]; then\n   164\t            echo "系统负载: $load_avg"\n   165\t        fi\n   166\t    fi\n   167\t    \n   168\t    # 获取详细负载信息\n   169\t    if [ -f /proc/loadavg ]; then\n   170\t        echo "详细负载信息:"\n   171\t        cat /proc/loadavg 2>/dev/null\n   172\t    fi\n   173\t    \n   174\t    echo\n   175\t}\n   176\t\n   177\t# 6. 开机时间\n   178\tget_uptime_info() {\n   179\t    echo -e "${GREEN}6. 开机时间${NC}"\n   180\t    echo "----------------"\n   181\t    \n   182\t    # 获取开机时间\n   183\t    if command -v uptime >/dev/null 2>&1; then\n   184\t        echo "系统运行时间:"\n   185\t        uptime 2>/dev/null\n   186\t    fi\n   187\t    \n   188\t    echo\n   189\t}\n   190\t\n   191\t# 7. 用户登录信息\n   192\tget_user_info() {\n   193\t    echo -e "${GREEN}7. 用户登录信息${NC}"\n   194\t    echo "----------------"\n   195\t    \n   196\t    # 显示当前登录用户\n   197\t    if command -v who >/dev/null 2>&1; then\n   198\t        echo "当前登录用户:"\n   199\t        who 2>/dev/null || echo "无法获取当前用户信息"\n   200\t    else\n   201\t        echo "无法获取当前用户信息"\n   202\t    fi\n   203\t    \n   204\t    echo\n   205\t}\n   206\t\n   207\t# 8. 网络连接状态\n   208\tget_network_info() {\n   209\t    echo -e "${GREEN}8. 网络连接状态${NC}"\n   210\t    echo "----------------"\n   211\t    \n   212\t    # 显示网络接口信息\n   213\t    if command -v ip >/dev/null 2>&1; then\n   214\t        echo "网络接口信息:"\n   215\t        ip addr show 2>/dev/null || echo "无法获取网络接口信息"\n   216\t    elif command -v ifconfig >/dev/null 2>&1; then\n   217\t        echo "网络接口信息:"\n   218\t        ifconfig 2>/dev/null || echo "无法获取网络接口信息"\n   219\t    else\n   220\t        echo "无法获取网络接口信息"\n   221\t    fi\n   222\t    \n   223\t    echo\n   224\t}\n   225\t\n   226\t# 9. 运行中的进程\n   227\tget_process_info() {\n   228\t    echo -e "${GREEN}9. 运行中的进程${NC}"\n   229\t    echo "----------------"\n   230\t    \n   231\t    # 显示前5个占用CPU最高的进程\n   232\t    if command -v ps >/dev/null 2>&1; then\n   233\t        echo "CPU使用率最高的前5个进程:"\n   234\t        ps aux --sort=-%cpu 2>/dev/null | head -6 || echo "无法获取进程信息"\n   235\t    else\n   236\t        echo "无法获取进程信息 (ps命令不可用)"\n   237\t    fi\n   238\t    \n   239\t    echo\n   240\t}\n   241\t\n   242\t# 10. 系统服务状态\n   243\tget_service_info() {\n   244\t    echo -e "${GREEN}10. 系统服务状态${NC}"\n   245\t    echo "----------------"\n   246\t    \n   247\t    # 检查systemctl是否存在\n   248\t    if command -v systemctl >/dev/null 2>&1; then\n   249\t        echo "主要服务状态 (运行中):"\n   250\t        systemctl list-units --type=service --state=running --no-pager 2>/dev/null | head -5 || echo "无法获取服务信息"\n   251\t    else\n   252\t        echo "systemctl不可用，无法查询服务状态"\n   253\t        # 尝试使用其他方式检查服务\n   254\t        if command -v service >/dev/null 2>&1; then\n   255\t            echo "使用service命令检查服务状态:"\n   256\t            service --status-all 2>/dev/null | head -5 || echo "无法获取服务信息"\n   257\t        fi\n   258\t    fi\n   259\t    \n   260\t    echo\n   261\t}\n   262\t\n   263\t# 主函数\n   264\tmain() {\n   265\t    local verbose=false\n   266\t    local quiet=false\n   267\t    \n   268\t    # 解析命令行参数\n   269\t    while [[ $# -gt 0 ]]; do\n   270\t        case $1 in\n   271\t            -h|--help)\n   272\t                show_help\n   273\t                exit 0\n   274\t                ;;\n   275\t            -v|--verbose)\n   276\t                verbose=true\n   277\t                shift\n   278\t                ;;\n   279\t            -q|--quiet)\n   280\t                quiet=true\n   281\t                shift\n   282\t                ;;\n   283\t            *)\n   284\t                echo -e "${RED}未知选项: $1${NC}"\n   285\t                show_help\n   286\t                exit 1\n   287\t                ;;\n   288\t        esac\n   289\t    done\n   290\t    \n   291\t    show_title\n   292\t    \n   293\t    # 根据参数选择性显示信息\n   294\t    if [ "$quiet" = true ]; then\n   295\t        get_system_info\n   296\t        get_cpu_info\n   297\t        get_memory_info\n   298\t        get_disk_info\n   299\t        get_load_info\n   300\t        get_uptime_info\n   301\t    else\n   302\t        get_system_info\n   303\t        get_cpu_info\n   304\t        get_memory_info\n   305\t        get_disk_info\n   306\t        get_load_info\n   307\t        get_uptime_info\n   308\t        get_user_info\n   309\t        get_network_info\n   310\t        get_process_info\n   311\t        get_service_info\n   312\t    fi\n   313\t    \n   314\t    echo -e "${BLUE}========================================${NC}"\n   315\t    echo -e "${BLUE}           查询完成${NC}"\n   316\t    echo -e "${BLUE}========================================${NC}"\n   317\t}\n   318\t\n   319\t# 执行主函数\n   320\tmain "$@"', tool_call_id='call_fd0aa2d31f0c4ef19f0a4c22', timestamp=datetime.datetime(2025, 12, 30, 8, 14, 22, 684871, tzinfo=datetime.timezone.utc)))
