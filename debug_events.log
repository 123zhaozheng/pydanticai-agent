nplt.savefig(f\'{output_dir}/问题来源分布.png\', dpi=300, bbox_inches=\'tight\')\\nplt.close()\\n\\n# 4. 采纳情况\\nplt.figure(figsize=(10, 6))\\nadopted_counts = df[\'是否采纳\'].value_counts()\\nbars = plt.bar(range(len(adopted_counts)), adopted_counts.values)\\nplt.title(\'AI回复采纳情况\')\\nplt.xlabel(\'采纳情况\')\\nplt.ylabel(\'问题数量\')\\nplt.xticks(range(len(adopted_counts)), adopted_counts.index, rotation=45)\\n# 添加数值标签\\nfor i, (bar, value) in enumerate(zip(bars, adopted_counts.values)):\\n    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.1,\\n             str(value), ha=\'center\', va=\'bottom\')\\nplt.tight_layout()\\nplt.savefig(f\'{output_dir}/AI回复采纳情况.png\', dpi=300, bbox_inches=\'tight\')\\nplt.close()\\n\\n# 5. 按负责人统计\\nplt.figure(figsize=(12, 8))\\nif \'负责人\' in df.columns:\\n    responsible_counts = df[\'负责人\'].value_counts()\\n    plt.pie(responsible_counts.values, labels=responsible_counts.index, autopct=\'%1.1f%%\')\\n    plt.title(\'按负责人问题分配情况\')\\n    plt.savefig(f\'{output_dir}/负责人问题分配.png\', dpi=300, bbox_inches=\'tight\')\\n    plt.close()\\n\\n# 6. 按提出人统计\\nplt.figure(figsize=(12, 8))\\nif \'提出人\' in df.columns:\\n    submitter_counts = df[\'提出人\'].value_counts().head(10)  # 取前10名\\n    bars = plt.bar(range(len(submitter_counts)), submitter_counts.values)\\n    plt.title(\'前10名问题提出人统计\')\\n    plt.xlabel(\'提出人\')\\n    plt.ylabel(\'问题数量\')\\n    plt.xticks(range(len(submitter_counts)), submitter_counts.index, rotation=45)\\n    # 添加数值标签\\n    for i, (bar, value) in enumerate(zip(bars, submitter_counts.values)):\\n        plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.1,\\n                 str(value), ha=\'center\', va=\'bottom\')\\n    plt.tight_layout()\\n    plt.savefig(f\'{output_dir}/前10名问题提出人.png\', dpi=300, bbox_inches=\'tight\')\\n    plt.close()\\n\\nprint(\\"图表已生成完毕！\\")"}', tool_call_id='call_9693c69517224ccb9a32d4da'))
