2025-12-29 14:02:03.825194 Event: <class 'pydantic_ai.messages.PartStartEvent'> PartStartEvent(index=2, part=ToolCallPart(tool_name='write_file', args='{"path":"/workspace/intermediate/time_analysis_fixed.py","content":"import pandas as pd\\nimport numpy as np\\nimport matplotlib.pyplot as plt\\nimport seaborn as sns\\nfrom datetime import datetime, timedelta\\nimport warnings\\nwarnings.filterwarnings(\'ignore\')\\n\\n# 设置中文字体支持\\nplt.rcParams[\'font.sans-serif\'] = [\'SimHei\', \'Microsoft YaHei\']\\nplt.rcParams[\'axes.unicode_minus\'] = False\\n\\n# 读取数据\\ndf = pd.read_excel(\'/workspace/uploads/昆小智问题处理计划.xlsx\')\\n\\nprint(\\"=\\" * 60)\\nprint(\\"昆小智问题处理计划 - 时间趋势和计划vs实际时间分析\\")\\nprint(\\"=\\" * 60)\\n\\n# 1. 数据预处理 - 转换时间列\\nprint(\\"\\\\n1. 数据预处理和清洗:\\")\\n\\n# 转换时间列为datetime格式\\ntry:\\n    df[\'计划时间\'] = pd.to_datetime(df[\'计划时间\'], errors=\'coerce\')\\n    df[\'实际解决时间\'] = pd.to_datetime(df[\'实际解决时间\'], errors=\'coerce\')\\n    print(\\"时间列转换成功\\")\\nexcept Exception as e:\\n    print(f\\"时间转换出错: {e}\\")\\n\\n# 检查缺失值\\nmissing_plan_time = df[\'计划时间\'].isnull().sum()\\nmissing_actual_time = df[\'实际解决时间\'].isnull().sum()\\nprint(f\\"计划时间缺失: {missing_plan_time} 条\\")\\nprint(f\\"实际解决时间缺失: {missing_actual_time} 条\\")\\n\\n# 2. 时间范围分析\\nprint(\\"\\\\n2. 时间范围分析:\\")\\nif \'计划时间\' in df.columns:\\n    valid_plan_times = df[\'计划时间\'].dropna()\\n    if len(valid_plan_times) > 0:\\n        print(f\\"计划时间范围: {valid_plan_times.min()} 到 {valid_plan_times.max()}\\")\\n        print(f\\"计划时间跨度: {(valid_plan_times.max() - valid_plan_times.min()).days} 天\\")\\n\\nif \'实际解决时间\' in df.columns:\\n    valid_actual_times = df[\'实际解决时间\'].dropna()\\n    if len(valid_actual_times) > 0:\\n        print(f\\"实际解决时间范围: {valid_actual_times.min()} 到 {valid_actual_times.max()}\\")\\n        print(f\\"实际解决时间跨度: {(valid_actual_times.max() - valid_actual_times.min()).days} 天\\")\\n\\n# 3. 时间效率分析\\nprint(\\"\\\\n3. 时间效率分析:\\")\\n\\n# 计算计划时间与实际解决时间的差异\\ntime_diff_days = []\\nfor i in range(len(df)):\\n    if pd.notna(df.loc[i, \'计划时间\']) and pd.notna(df.loc[i, \'实际解决时间\']):\\n        diff = (df.loc[i, \'实际解决时间\'] - df.loc[i, \'计划时间\']).days\\n        time_diff_days.append(diff)\\n    else:\\n        time_diff_days.append(np.nan)\\n\\ndf[\'时间差(天)\'] = time_diff_days\\n\\n# 分析时间差异\\nvalid_diffs = df[\'时间差(天)\'].dropna()\\nif len(valid_diffs) > 0:\\n    print(f\\"\\\\n有效时间差记录数: {len(valid_diffs)}\\")\\n    print(f\\"平均时间差: {valid_diffs.mean():.1f} 天\\")\\n    print(f\\"中位数时间差: {valid_diffs.median():.1f} 天\\")\\n    print(f\\"时间差标准差: {valid_diffs.std():.1f} 天\\")\\n    \\n    # 时间差分布\\n    print(f\\"\\\\n时间差分布:\\")\\n    print(f\\"提前完成: {(valid_diffs < 0).sum()} 个\\")\\n    print(f\\"按时完成: {(valid_diffs == 0).sum()} 个\\") \\n    print(f\\"延迟完成: {(valid_diffs > 0).sum()} 个\\")\\n    \\n    # 详细统计\\n    print(f\\"\\\\n延迟完成详细统计:\\")\\n    delays = valid_diffs[valid_diffs > 0]\\n    if len(delays) > 0:\\n        print(f\\"最小延迟: {delays.min()} 天\\")\\n        print(f\\"最大延迟: {delays.max()} 天\\")\\n        print(f\\"平均延迟: {delays.mean():.1f} 天\\")\\n\\n# 4. 按月份/周分析\\nprint(\\"\\\\n4. 时间趋势分析:\\")\\n\\n# 按周分组分析\\nif \'计划时间\' in df.columns:\\n    df[\'计划周\'] = df[\'计划时间\'].dt.isocalendar().week\\n    weekly_plan = df.groupby(\'计划周\').size()\\n    \\n    if \'实际解决时间\' in df.columns:\\n        df[\'实际周\'] = df[\'实际解决时间\'].dt.isocalendar().week\\n        weekly_actual = df.groupby(\'实际周\').size().reindex(weekly_plan.index, fill_value=0)\\n        \\n        print(\\"\\\\n每周问题处理情况:\\")\\n        week_data = pd.DataFrame({\\n            \'计划问题数\': weekly_plan,\\n            \'实际解决数\': weekly_actual\\n        })\\n        print(week_data)\\n\\n# 5. 计划完成率分析\\nprint(\\"\\\\n5. 计划完成率分析:\\")\\n\\n# 计算完成率\\ncompleted_on_time = (df[\'时间差(天)\'] == 0).sum()\\ncompleted_early = (df[\'时间差(天)\'] < 0).sum()\\ndelayed = (df[\'时间差(天)\'] > 0).sum()\\nno_time_data = df[\'时间差(天)\'].isnull().sum()\\n\\ntotal_with_time_data = len(df) - no_time_data\\nif total_with_time_data > 0:\\n    on_time_rate = completed_on_time / total_with_time_data * 100\\n    early_rate = completed_early / total_with_time_data * 100\\n    delayed_rate = delayed / total_with_time_data * 100\\n    \\n    print(f\\"\\\\n时间完成率统计:\\")\\n    print(f\\"按时完成: {completed_on_time} 个 ({on_time_rate:.1f}%)\\")\\n    print(f\\"提前完成: {completed_early} 个 ({early_rate:.1f}%)\\")\\n    print(f\\"延迟完成: {delayed} 个 ({delayed_rate:.1f}%)\\")\\n    print(f\\"无时间数据: {no_time_data} 个\\")\\n\\n# 6. 创建时间分析图表\\nprint(\\"\\\\n6. 创建可视化图表:\\")\\n\\n# 图表1: 时间差分布\\nplt.figure(figsize=(12, 6))\\nplt.subplot(1, 2, 1)\\nvalid_diffs_clean = valid_diffs.dropna()\\nif len(valid_diffs_clean) > 0:\\n    plt.hist(valid_diffs_clean, bins=10, alpha=0.7, color=\'skyblue\', edgecolor=\'black\')\\n    plt.axvline(x=0, color=\'red\', linestyle=\'--\', label=\'计划时间\')\\n    plt.xlabel(\'时间差(天)\')\\n    plt.ylabel(\'频次\')\\n    plt.title(\'时间差分布\')\\n    plt.legend()\\n    plt.grid(True, alpha=0.3)\\n\\n# 图表2: 计划vs实际时间对比\\nplt.subplot(1, 2, 2)\\nif len(valid_diffs_clean) > 0:\\n    categories = [\'提前完成\', \'按时完成\', \'延迟完成\']\\n    counts = [completed_early, completed_on_time, delayed]\\n    colors = [\'green\', \'orange\', \'red\']\\n    \\n    plt.pie(counts, labels=categories, autopct=\'%1.1f%%\', colors=colors, startangle=90)\\n    plt.title(\'计划完成情况分布\')\\n\\nplt.tight_layout()\\nplt.savefig(\'/workspace/intermediate/time_difference_analysis.png\', dpi=300, bbox_inches=\'tight\')\\nplt.close()\\nprint(\\"时间差分析图表已保存至: /workspace/intermediate/time_difference_analysis.png\\")\\n\\n# 图表3: 时间趋势线图\\nplt.figure(figsize=(12, 6))\\nif \'计划时间\' in df.columns and \'实际解决时间\' in df.columns:\\n    # 提取有完整时间数据的记录\\n    time_data = df.dropna(subset=[\'计划时间\', \'实际解决时间\'])\\n    \\n    # 按计划时间排序\\n    time_data_sorted = time_data.sort_values(\'计划时间\')\\n    \\n    # 转换为数值便于绘图\\n    plan_days = time_data_sorted[\'计划时间\'].dt.day\\n    actual_days = time_data_sorted[\'实际解决时间\'].dt.day\\n    \\n    # 绘制时间线\\n    plt.plot(range(len(time_data_sorted)), plan_days, \\n             \'o-\', label=\'计划时间\', color=\'blue\', marker=\'o\')\\n    plt.plot(range(len(time_data_sorted)), actual_days, \\n             \'s-\', label=\'实际解决时间\', color=\'red\', marker=\'s\')\\n    \\n    plt.xlabel(\'问题序号\')\\n    plt.ylabel(\'日期(日)\')\\n    plt.title(\'计划时间 vs 实际解决时间对比\')\\n    plt.legend()\\n    plt.grid(True, alpha=0.3)\\n    \\n    # 添加时间差标签\\n    for i, (plan, actual) in enumerate(zip(plan_days, actual_days)):\\n        diff = actual - plan\\n        color = \'green\' if diff < 0 else \'red\' if diff > 0 else \'blue\'\\n        plt.annotate(f\'{diff:+.0f}\', (i, actual), \\n                    xytext=(5, 5), textcoords=\'offset points\',\\n                    color=color, fontweight=\'bold\')\\n\\nplt.tight_layout()\\nplt.savefig(\'/workspace/intermediate/time_trend_analysis.png\', dpi=300, bbox_inches=\'tight\')\\nplt.close()\\nprint(\\"时间趋势图表已保存至: /workspace/intermediate/time_trend_analysis.png\\")\\n\\n# 图表4: 按状态的时间分析\\nplt.figure(figsize=(10, 6))\\nif \'状态\' in df.columns:\\n    status_time_data = df.dropna(subset=[\'计划时间\', \'实际解决时间\'])\\n    \\n    if len(status_time_data) > 0:\\n        # 计算每个状态的时间差异\\n        for status in status_time_data[\'状态\'].unique():\\n            if pd.notna(status):\\n                mask = status_time_data[\'状态\'] == status\\n                status_data = status_time_data[mask]\\n                \\n                if len(status_data) > 0:\\n                    time_diffs = status_data[\'时间差(天)\'].dropna()\\n                    if len(time_diffs) > 0:\\n                        plt.hist(time_diffs, alpha=0.6, label=f\'{status} ({len(time_diffs)}个)\',\\n                                bins=10, density=True)\\n        \\n        plt.xlabel(\'时间差(天)\')\\n        plt.ylabel(\'密度\')\\n        plt.title(\'按状态的时间差分布\')\\n        plt.legend()\\n        plt.grid(True, alpha=0.3)\\n        plt.axvline(x=0, color=\'red\', linestyle=\'--\', alpha=0.7)\\n\\nplt.tight_layout()\\nplt.savefig(\'/workspace/intermediate/status_time_analysis.png\', dpi=300, bbox_inches=\'tight\')\\nplt.close()\\nprint(\\"状态时间分析图表已保存至: /workspace/intermediate/status_time_analysis.png\\")\\n\\n# 7. 延迟问题详细分析\\nprint(\\"\\\\n7. 延迟问题详细分析:\\")\\nif len(valid_diffs) > 0:\\n    delayed_issues = df[df[\'时间差(天)\'] > 0]\\n    if len(delayed_issues) > 0:\\n        print(\\"\\\\n延迟问题详情:\\")\\n        for i, (_, row) in enumerate(delayed_issues.iterrows(), 1):\\n            print(f\\"{i}. 延迟 {row[\'时间差(天)\']} 天 - {row[\'问题原因\']}\\")\\n    else:\\n        print(\\"无延迟问题\\")\\n\\n# 8. 时间管理建议\\nprint(\\"\\\\n8. 时间管理建议:\\")\\nprint(\\"\\\\n基于时间分析的建议:\\")\\nprint(\\"1. 重点关注延迟问题，分析延迟原因\\")\\nprint(\\"2. 优化问题预估时间，提高时间准确性\\")\\nprint(\\"3. 建立时间预警机制，及时发现潜在延迟\\")\\nprint(\\"4. 加强团队协作，提高问题处理效率\\")\\nprint(\\"5. 定期回顾时间数据，持续改进流程\\")\\n\\n# 9. 数据质量评估\\nprint(\\"\\\\n9. 数据质量评估:\\")\\ntime_completeness = (1 - df[[\'计划时间\', \'实际解决时间\']].isnull().sum().sum() / (2 * len(df))) * 100\\nprint(f\\"时间数据完整率: {time_completeness:.1f}%\\")\\n\\nif time_completeness < 80:\\n    print(\\"警告: 时间数据完整性较低，可能影响分析准确性\\")\\n\\nprint(\\"\\\\n\\" + \\"=\\" * 60)\\nprint(\\"时间趋势和计划vs实际时间分析完成！\\")\\nprint(\\"=\\" * 60)"}', tool_call_id='call_0b63ee120cad4b0895dcdb8c'), previous_part_kind='text')
