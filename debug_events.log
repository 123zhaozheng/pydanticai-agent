表头背景色\\n    for i in [0, 2]:\\n        for row in basic_table.rows:\\n            set_cell_shading(row.cells[i], \'E7E6E6\')\\n    \\n    doc.add_paragraph()\\n    add_formatted_paragraph(doc,\\n        \'经核查，该公司工商登记信息真实有效，营业执照在有效期内，经营范围与实际业务相符。\'\\n        \'公司注册资本已全额实缴到位，股东出资真实。\', first_line_indent=0.74)\\n    \\n    doc.add_heading(\'（二）企业发展历程\', level=2)\\n    \\n    history = [\\n        \'2015年3月：公司在杭州市滨江区注册成立，初始注册资本500万元，主要从事企业管理软件开发；\',\\n        \'2016年8月：完成首轮天使融资，获得知名投资机构500万元投资，注册资本增至1,000万元；\',\\n        \'2017年12月：自主研发的\\"智远ERP系统\\"正式上线，获得首批企业客户；\',\\n        \'2018年6月：通过ISO9001质量管理体系认证和ISO27001信息安全管理体系认证；\',\\n        \'2019年3月：完成A轮融资2,000万元，注册资本增至3,000万元，业务拓展至华东地区；\',\\n        \'2020年9月：获得国家高新技术企业认定，研发投入占比超过15%；\',\\n        \'2021年5月：推出智能制造解决方案，进军工业互联网领域；\',\\n        \'2022年8月：完成B轮融资5,000万元，注册资本增至5,000万元，员工规模突破200人；\',\\n        \'2023年11月：获评浙江省\\"专精特新\\"中小企业，年营业收入突破2亿元；\',\\n        \'2024年6月：与多家大型央企、国企建立战略合作关系，业务版图扩展至全国。\'\\n    ]\\n    \\n    for item in history:\\n        add_formatted_paragraph(doc, item, first_line_indent=0.74)\\n    \\n    # 保存第一部分\\n    doc.save(\'/workspace/intermediate/银行客户尽职调查报告_行长版.docx\')\\n    print(\\"报告第一部分已生成...\\")\\n    return doc\\n\\nif __name__ == \\"__main__\\":\\n    doc = create_professional_report()\\n    print(\\"正在继续生成报告...\\")\\n","path":"/workspace/intermediate/generate_bank_report.py"}', tool_call_id='tooluse_Pw3xuKCMRRiQCQldSwGYgg'))
