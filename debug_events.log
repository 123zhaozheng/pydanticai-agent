 \'根据《XX银行公司授信业务管理办法》《XX银行信贷尽职调查工作指引》及相关规定，\'\\n        \'公司业务部指派客户经理李明辉对该公司进行全面尽职调查，形成本报告，供审批决策参考。\')\\n    \\n    doc.add_heading(\'（二）调查方式与过程\', level=2)\\n    add_para(doc, \'本次尽职调查历时14天，采用以下方式进行：\')\\n    \\n    methods = [\\n        \'1. 实地走访：于2025年12月16日、12月20日、12月25日三次赴企业经营场所进行现场调查，\'\\n        \'实地查看企业办公环境、研发中心、机房设施、员工工作状态等，核实企业实际经营情况；\',\\n        \\n        \'2. 高管访谈：与公司董事长王建国、总经理张伟、财务总监刘芳、技术总监李强等核心管理层\'\\n        \'进行深入访谈，详细了解企业发展历程、战略规划、经营状况、融资需求及还款安排；\',\\n        \\n        \'3. 资料审核：收集并审核企业营业执照、公司章程、股东会决议、财务报表（2022-2024年度）、\'\\n        \'审计报告、纳税证明、银行流水、主要业务合同、知识产权证书等相关资料，核实信息真实性；\',\\n        \\n        \'4. 外部查询：通过国家企业信用信息公示系统、中国裁判文书网、中国执行信息公开网、\'\\n        \'全国法院失信被执行人名单、人民银行征信系统、税务系统等渠道全面核查企业及关联方信用状况；\',\\n        \\n        \'5. 行业研究：查阅中国软件行业协会报告、工信部政策文件、券商研究报告等，\'\\n        \'深入分析企业所处行业发展趋势、竞争格局及政策环境；\',\\n        \\n        \'6. 客户走访：电话回访企业主要客户3家，了解业务合作情况及客户评价。\'\\n    ]\\n    for m in methods:\\n        add_para(doc, m)\\n\\ndef create_section1_continued(doc):\\n    \\"\\"\\"一、调查概述（续）\\"\\"\\"\\n    doc.add_heading(\'（三）调查结论摘要\', level=2)\\n    \\n    add_para(doc,\\n        \'经全面深入调查分析，现将主要调查结论汇报如下：\')\\n    \\n    conclusions = [\\n        \'1. 企业资质优良：智远科技是一家专注于企业级软件开发与智能化解决方案的高新技术企业，\'\\n        \'拥有国家高新技术企业认定、浙江省\\"专精特新\\"中小企业认定，具备软件企业认定证书、\'\\n        \'ISO9001质量管理体系认证、ISO27001信息安全管理体系认证等多项资质，企业规范运营。\',\\n        \\n        \'2. 技术实力雄厚：公司拥有研发人员156人，占员工总数54.5%，累计获得软件著作权68项、\'\\n        \'发明专利12项、实用新型专利23项。核心产品\\"智远ERP系统\\"、\\"智远MES系统\\"在细分市场\'\\n        \'具有较强竞争力，技术壁垒较高。\',\\n        \\n        \'3. 经营业绩优秀：公司近三年营业收入分别为1.28亿元、1.76亿元、2.35亿元，\'\\n        \'复合增长率35.6%；净利润分别为1,520万元、2,180万元、3,080万元，复合增长率42.3%。\'\\n        \'2024年1-11月实现营业收入2.68亿元，同比增长32.5%，预计全年可达2.95亿元。\',\\n        \\n        \'4. 财务状况健康：截至2024年11月末，公司总资产3.86亿元，净资产1.92亿元，\'\\n        \'资产负债率50.3%，流动比率1.85，速动比率1.62，各项财务指标处于行业优良水平。\'\\n        \'公司现金流充裕，经营性现金流净额持续为正。\',\\n        \\n        \'5. 信用记录良好：企业及实际控制人征信记录良好，无不良贷款记录，无重大诉讼纠纷，\'\\n        \'无行政处罚记录，纳税信用等级为A级，在我行历史合作中从未发生逾期。\',\\n        \\n        \'6. 还款来源可靠：公司主营业务稳定，客户资源优质（包括多家央企、国企及上市公司），\'\\n        \'合同订单充足，预计未来现金流可有效覆盖本次授信的还本付息需求。\'\\n    ]\\n    for c in conclusions:\\n        add_para(doc, c)\\n    \\n    add_para(doc,\\n        \'综合评估，该公司经营规范、财务健康、信用良好、还款来源可靠，符合我行授信准入条件。\'\\n        \'建议给予综合授信额度人民币5,000万元，期限一年，采用房产抵押+股东连带责任保证的担保方式，\'\\n        \'具体授信方案详见本报告第十部分。\', bold=True)\\n\\ndef create_section2(doc):\\n    \\"\\"\\"二、企业基本情况\\"\\"\\"\\n    doc.add_page_break()\\n    doc.add_heading(\'二、企业基本情况\', level=1)\\n    \\n    doc.add_heading(\'（一）工商登记信息\', level=2)\\n    \\n    # 基本信息表格\\n    table = doc.add_table(rows=14, cols=4)\\n    table.style = \'Table Grid\'\\n    \\n    data = [\\n        (\'企业名称\', \'杭州智远科技有限公司\', \'统一社会信用代码\', \'91330100MA2KXXXX\'),\\n        (\'企业类型\', \'有限责任公司（自然人投资或控股）\', \'成立日期\', \'2015年03月18日\'),\\n        (\'注册资本\', \'人民币5,000万元\', \'实缴资本\', \'人民币5,000万元\'),\\n        (\'法定代表人\', \'王建国\', \'联系电话\', \'0571-8888XXXX\'),\\n        (\'注册地址\', \'杭州市滨江区网商路XXX号XX大厦18层\', \'\', \'\'),\\n        (\'实际经营地址\', \'杭州市滨江区网商路XXX号XX大厦18-19层（自有物业）\', \'\', \'\'),\\n        (\'经营范围\', \'计算机软件开发、技术咨询、技术服务、技术转让；信息系统集成服务；\'\\n                    \'数据处理和存储服务；人工智能技术研发及应用；电子产品销售（依法须经批准的项目，\'\\n                    \'经相关部门批准后方可开展经营活动）\', \'\', \'\'),\\n        (\'营业期限\', \'2015年03月18日至长期\', \'核准日期\', \'2024年06月15日\'),\\n        (\'登记机关\', \'杭州市滨江区市场监督管理局\', \'企业状态\', \'存续（在营、开业）\'),\\n        (\'参保人数\', \'286人\', \'纳税人资质\', \'增值税一般纳税人\'),\\n        (\'高新技术企业\', \'是（证书编号：GR202533XXXXXX）\', \'有效期至\', \'2026年12月\'),\\n        (\'专精特新企业\', \'浙江省\\"专精特新\\"中小企业\', \'认定时间\', \'2024年05月\'),\\n        (\'软件企业认定\', \'是（证书编号：浙RQ-2020-XXXX）\', \'有效期至\', \'2025年12月\'),\\n        (\'ISO认证\', \'ISO9001、ISO27001、ISO20000\', \'认证机构\', \'SGS通标\')\\n    ]\\n    \\n    for i, row_data in enumerate(data):\\n        for j, val in enumerate(row_data):\\n            table.cell(i, j).text = val\\n            if j in [0, 2]:\\n                set_cell_shading(table.cell(i, j), \'E7E6E6\')\\n    \\n    doc.add_paragraph()\\n    add_para(doc,\\n        \'经核查，该公司工商登记信息真实有效，营业执照在有效期内，经营范围与实际业务相符。\'\\n        \'公司注册资本5,000万元已于2022年8月全额实缴到位（经审计确认），股东出资真实合法。\'\\n        \'公司各项资质证书齐全有效，具备开展相关业务的合法资质。\')\\n\\ndef main():\\n    \\"\\"\\"主函数\\"\\"\\"\\n    doc = Document()\\n    \\n    # 设置页面\\n    section = doc.sections[0]\\n    section.top_margin = Cm(2.54)\\n    section.bottom_margin = Cm(2.54)\\n    section.left_margin = Cm(3.17)\\n    section.right_margin = Cm(3.17)\\n    \\n    # 生成各部分\\n    create_cover_page(doc)\\n    create_toc(doc)\\n    create_section1(doc)\\n    create_section1_continued(doc)\\n    create_section2(doc)\\n    \\n    # 保存\\n    doc.save(\'/workspace/intermediate/银行客户尽职调查报告_行长版.docx\')\\n    print(\\"第一部分已生成...\\")\\n    return doc\\n\\nif __name__ == \\"__main__\\":\\n    doc = main()\\n","path":"/workspace/intermediate/generate_full_report.py"}', tool_call_id='tooluse_JC9M9G5xR9mSVGHLscKf9g'))
