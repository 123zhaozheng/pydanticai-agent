\nprint(user_activity[[\'用户\', \'问题数量\', \'活跃天数\', \'平均每日提交\']].sort_values(\'问题数量\', ascending=False).head(10))\\n\\n# 2. 问题类型深度分析\\nprint(\\"\\\\n=== 问题类型深度分析 ===\\")\\nif \'问题类型\' in df.columns:\\n    # 问题类型统计\\n    type_stats = df[\'问题类型\'].value_counts()\\n    print(f\\"总共有 {len(type_stats)} 种不同的问题类型\\")\\n    print(f\\"最常见的问题类型: {type_stats.index[0]} ({type_stats.iloc[0]}次)\\")\\n    \\n    # 按用户分析问题类型偏好\\n    user_type_preference = df.groupby([\'用户\', \'问题类型\']).size().unstack(fill_value=0)\\n    print(\\"\\\\n用户问题类型偏好 (TOP5用户的主要问题类型):\\")\\n    top_users = df[\'用户\'].value_counts().head(5).index\\n    for user in top_users:\\n        if user in user_type_preference.index:\\n            user_types = user_type_preference.loc[user].sort_values(ascending=False)\\n            print(f\\"\\\\n{user}:\\")\\n            for problem_type, count in user_types.head(3).items():\\n                if count > 0:\\n                    print(f\\"  {problem_type}: {count}次\\")\\n\\n# 3. 时间模式分析\\nprint(\\"\\\\n=== 时间模式分析 ===\\")\\n# 小时分布\\nhourly_stats = df[\'小时\'].value_counts().sort_index()\\nprint(\\"\\\\n24小时问题提交分布:\\")\\nprint(hourly_stats)\\n\\n# 星期分布\\nweekday_stats = df[\'星期几\'].value_counts()\\nprint(\\"\\\\n星期问题提交分布:\\")\\nprint(weekday_stats)\\n\\n# 4. 问题描述关键词分析\\nprint(\\"\\\\n=== 问题描述关键词分析 ===\\")\\n# 分析原始问题中的关键词\\nall_questions = \' \'.join(df[\'原始问题\'].dropna().astype(str))\\n# 提取中文关键词（简单实现）\\nchinese_words = re.findall(r\'[\\\\u4e00-\\\\u9fff]+\', all_questions)\\nword_counts = Counter(chinese_words)\\n\\n# 过滤掉常见无意义词\\nstop_words = {\'的\', \'了\', \'是\', \'在\', \'我\', \'你\', \'他\', \'它\', \'这\', \'那\', \'有\', \'和\', \'或\', \'但\', \'一个\', \'问题\', \'需要\'}\\nfiltered_words = {word: count for word, count in word_counts.items() \\n                 if count > 2 and word not in stop_words and len(word) > 1}\\n\\nprint(f\\"\\\\n总共提取到 {len(filtered_words)} 个有效关键词\\")\\nprint(\\"\\\\n高频关键词 (TOP20):\\")\\ntop_words = Counter(filtered_words).most_common(20)\\nfor word, count in top_words:\\n    print(f\\"{word}: {count}次\\")\\n\\n# 5. 数据质量问题诊断\\nprint(\\"\\\\n=== 数据质量问题诊断 ===\\")\\nmissing_analysis = pd.DataFrame({\\n    \'缺失数量\': df.isnull().sum(),\\n    \'缺失比例(%)\': (df.isnull().sum() / len(df) * 100).round(1),\\n    \'数据质量\': [\'差\' if x > 50 else \'中\' if x > 20 else \'良\' if x > 0 else \'优\' for x in df.isnull().sum()]\\n})\\n\\nprint(\\"数据质量诊断表:\\")\\nprint(missing_analysis[missing_analysis[\'缺失数量\'] > 0].sort_values(\'缺失比例(%)\', ascending=False))\\n\\n# 6. 异常检测\\nprint(\\"\\\\n=== 异常检测 ===\\")\\n# 检测异常高频用户\\nuser_freq = df[\'用户\'].value_counts()\\nmean_freq = user_freq.mean()\\nstd_freq = user_freq.std()\\nhigh_freq_users = user_freq[user_freq > mean_freq + 2*std_freq]\\n\\nprint(f\\"异常高频用户 (超过均值+2倍标准差):\\")\\nfor user, count in high_freq_users.items():\\n    print(f\\"{user}: {count}次 (均值: {mean_freq:.1f}, 标准差: {std_freq:.1f})\\")\\n\\n# 检测异常提交时间\\ndaily_counts = df[\'日期\'].value_counts()\\nmean_daily = daily_counts.mean()\\nstd_daily = daily_counts.std()\\nhigh_activity_days = daily_counts[daily_counts > mean_daily + 1.5*std_daily]\\n\\nprint(f\\"\\\\n异常高活跃日期 (超过均值+1.5倍标准差):\\")\\nfor date, count in high_activity_days.items():\\n    print(f\\"{date}: {count}次\\")\\n\\n# 7. 综合建议\\nprint(\\"\\\\n=== 综合分析建议 ===\\")\\nrecommendations = []\\n\\n# 基于用户活跃度的建议\\nif len(high_freq_users) > 0:\\n    recommendations.append(\\"• 发现异常高频用户，建议重点关注其问题质量和系统使用体验\\")\\n\\n# 基于问题类型的建议\\nif \'问题类型\' in df.columns and len(type_stats) > 0:\\n    top_type_ratio = type_stats.iloc[0] / len(df) * 100\\n    if top_type_ratio > 20:\\n        recommendations.append(f\\"• \'{type_stats.index[0]}\'是主要问题类型，占比{top_type_ratio:.1f}%，建议针对性优化\\")\\n\\n# 基于数据质量的建议\\nmissing_cols = missing_analysis[missing_analysis[\'数据质量\'] != \'优\'].index.tolist()\\nif len(missing_cols) > 0:\\n    recommendations.append(f\\"• {len(missing_cols)}个字段存在数据质量问题，建议完善数据收集规范\\")\\n\\n# 基于时间趋势的建议\\nif len(daily_counts) > 1:\\n    trend = \\"上升\\" if daily_counts.iloc[-1] > daily_counts.iloc[0] else \\"下降\\"\\n    recommendations.append(f\\"• 问题提交趋势呈现{trend}态势，建议监控系统负载和用户反馈\\")\\n\\nprint(\\"综合建议:\\")\\nfor i, rec in enumerate(recommendations, 1):\\n    print(f\\"{i}. {rec}\\")\\n\\n# 保存分析结果\\nanalysis_results = {\\n    \'基本统计\': {\\n        \'总问题数量\': len(df),\\n        \'用户数量\': df[\'用户\'].nunique(),\\n        \'时间范围\': f\\"{df[\'提交时间\'].min()} 至 {df[\'提交时间\'].max()}\\",\\n        \'提出人数量\': df[\'提出人\'].nunique()\\n    },\\n    \'用户活跃度\': user_activity[[\'用户\', \'问题数量\', \'活跃天数\', \'平均每日提交\']].sort_values(\'问题数量\', ascending=False).head(10).to_dict(\'records\'),\\n    \'问题类型分布\': type_stats.head(10).to_dict() if \'问题类型\' in df.columns else {},\\n    \'时间分布\': {\\n        \'小时分布\': hourly_stats.to_dict(),\\n        \'星期分布\': weekday_stats.to_dict()\\n    },\\n    \'高频关键词\': top_words,\\n    \'异常检测\': {\\n        \'异常高频用户\': high_freq_users.to_dict(),\\n        \'异常高活跃日期\': {str(date): count for date, count in high_activity_days.items()}\\n    },\\n    \'建议\': recommendations\\n}\\n\\nwith open(\'/workspace/intermediate/analysis_results.json\', \'w\', encoding=\'utf-8\') as f:\\n    json.dump(analysis_results, f, ensure_ascii=False, indent=2, default=str)\\n\\nprint(f\\"\\\\n分析结果已保存至: /workspace/intermediate/analysis_results.json\\")\\nprint(\\"综合分析完成！\\")\\n\\n# 生成补充PDF报告\\nprint(\\"\\\\n正在生成补充分析报告...\\")\\nfig, axes = plt.subplots(2, 2, figsize=(15, 12))\\n\\n# 用户活跃度图\\ntop_10_users = user_activity.sort_values(\'问题数量\', ascending=False).head(10)\\naxes[0,0].barh(range(len(top_10_users)), top_10_users[\'问题数量\'], color=\'skyblue\')\\naxes[0,0].set_yticks(range(len(top_10_users)))\\naxes[0,0].set_yticklabels(top_10_users[\'用户\'])\\naxes[0,0].set_xlabel(\'问题数量\')\\naxes[0,0].set_title(\'用户活跃度排行 (TOP10)\')\\n\\n# 问题类型分布图\\nif \'问题类型\' in df.columns:\\n    top_10_types = type_stats.head(10)\\n    axes[0,1].pie(top_10_types.values, labels=top_10_types.index, autopct=\'%1.1f%%\')\\n    axes[0,1].set_title(\'问题类型分布 (TOP10)\')\\n\\n# 时间趋势图\\ndaily_trend = df[\