2025-12-29 10:35:53.164110 Event: <class 'pydantic_ai.messages.PartDeltaEvent'> PartDeltaEvent(index=1, delta=ToolCallPartDelta(args_delta='{"content":"#!/usr/bin/env python3\\n\\"\\"\\"\\n银行客户尽职调查报告生成器\\n生成可直接呈报行长的专业调查报告\\n\\"\\"\\"\\n\\nfrom docx import Document\\nfrom docx.shared import Inches, Pt, Cm, RGBColor\\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH, WD_LINE_SPACING\\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\\nfrom docx.oxml.ns import qn\\nfrom docx.oxml import OxmlElement\\nimport datetime\\n\\ndef set_cell_shading(cell, color):\\n    \\"\\"\\"设置单元格背景色\\"\\"\\"\\n    shading = OxmlElement(\'w:shd\')\\n    shading.set(qn(\'w:fill\'), color)\\n    cell._tc.get_or_add_tcPr().append(shading)\\n\\ndef add_formatted_paragraph(doc, text, bold=False, size=12, space_after=6, first_line_indent=None, alignment=None):\\n    \\"\\"\\"添加格式化段落\\"\\"\\"\\n    para = doc.add_paragraph()\\n    run = para.add_run(text)\\n    run.font.size = Pt(size)\\n    run.font.bold = bold\\n    para.paragraph_format.space_after = Pt(space_after)\\n    if first_line_indent:\\n        para.paragraph_format.first_line_indent = Cm(first_line_indent)\\n    if alignment:\\n        para.alignment = alignment\\n    return para\\n\\ndef create_professional_report():\\n    \\"\\"\\"创建专业的银行客户尽职调查报告\\"\\"\\"\\n    \\n    doc = Document()\\n    \\n    # 设置页面\\n    section = doc.sections[0]\\n    section.top_margin = Cm(2.54)\\n    section.bottom_margin = Cm(2.54)\\n    section.left_margin = Cm(3.17)\\n    section.right_margin = Cm(3.17)\\n    \\n    # ==================== 封面 ====================\\n    for _ in range(3):\\n        doc.add_paragraph()\\n    \\n    # 银行名称\\n    bank_name = doc.add_paragraph()\\n    bank_run = bank_name.add_run(\'XX银行股份有限公司\')\\n    bank_run.font.size = Pt(22)\\n    bank_run.font.bold = True\\n    bank_name.alignment = WD_ALIGN_PARAGRAPH.CENTER\\n    \\n    doc.add_paragraph()\\n    \\n    # 报告标题\\n    title = doc.add_paragraph()\\n    title_run = title.add_run(\'企业客户尽职调查报告\')\\n    title_run.font.size = Pt(26)\\n    title_run.font.bold = True\\n    title.alignment = WD_ALIGN_PARAGRAPH.CENTER\\n    \\n    doc.add_paragraph()\\n    doc.add_paragraph()\\n    \\n    # 客户名称\\n    customer = doc.add_paragraph()\\n    customer_run = customer.add_run(\'客户名称：杭州智远科技有限公司\')\\n    customer_run.font.size = Pt(16)\\n    customer.alignment = WD_ALIGN_PARAGRAPH.CENTER\\n    \\n    doc.add_paragraph()\\n    \\n    # 报告信息表格\\n    info_table = doc.add_table(rows=4, cols=2)\\n    info_table.alignment = WD_TABLE_ALIGNMENT.CENTER\\n    \\n    info_data = [\\n        (\'报告编号\', \'DD-2025-HZ-00128\'),\\n        (\'调查类型\', \'授信业务尽职调查\'),\\n        (\'调查日期\', \'2025年12月15日至2025年12月28日\'),\\n        (\'报告日期\', datetime.datetime.now().strftime(\'%Y年%m月%d日\'))\\n    ]\\n    \\n    for i, (label, value) in enumerate(info_data):\\n        info_table.cell(i, 0).text = label\\n        info_table.cell(i, 1).text = value\\n    \\n    for _ in range(6):\\n        doc.add_paragraph()\\n    \\n    # 编制信息\\n    dept = doc.add_paragraph()\\n    dept_run = dept.add_run(\'编制部门：公司业务部\')\\n    dept_run.font.size = Pt(14)\\n    dept.alignment = WD_ALIGN_PARAGRAPH.CENTER\\n    \\n    author = doc.add_paragraph()\\n    author_run = author.add_run(\'调查人员：李明辉（客户经理）\')\\n    author_run.font.size = Pt(14)\\n    author.alignment = WD_ALIGN_PARAGRAPH.CENTER\\n    \\n    # ==================== 目录页 ====================\\n    doc.add_page_break()\\n    \\n    toc_title = doc.add_paragraph()\\n    toc_run = toc_title.add_run(\'目    录\')\\n    toc_run.font.size = Pt(18)\\n    toc_run.font.bold = True\\n    toc_title.alignment = WD_ALIGN_PARAGRAPH.CENTER\\n    toc_title.paragraph_format.space_after = Pt(24)\\n    \\n    toc_items = [\\n        \'一、调查概述 .................................................. 3\',\\n        \'二、企业基本情况 .............................................. 4\',\\n        \'三、股权结构与关联企业 ........................................ 5\',\\n        \'四、经营情况分析 .............................................. 6\',\\n        \'五、财务状况分析 .............................................. 8\',\\n        \'六、银行往来及信用记录 ....................................... 11\',\\n        \'七、行业分析与市场地位 ....................................... 12\',\\n        \'八、风险分析与评估 ........................................... 14\',\\n        \'九、担保措施分析 ............................................. 16\',\\n        \'十、综合评价与授信建议 ....................................... 17\',\\n        \'附件清单 ..................................................... 19\'\\n    ]\\n    \\n    for item in toc_items:\\n        p = doc.add_paragraph(item)\\n        p.paragraph_format.space_after = Pt(12)\\n    \\n    # ==================== 正文开始 ====================\\n    doc.add_page_break()\\n    \\n    # 一、调查概述\\n    doc.add_heading(\'一、调查概述\', level=1)\\n    \\n    doc.add_heading(\'（一）调查背景\', level=2)\\n    add_formatted_paragraph(doc, \\n        \'杭州智远科技有限公司（以下简称\\"智远科技\\"或\\"该公司\\"）系我行存量优质客户，\'\\n        \'自2019年与我行建立业务合作关系以来，双方合作良好，客户信用记录优良。\'\\n        \'近期，该公司因业务快速发展，拟向我行申请综合授信额度人民币5,000万元，\'\\n        \'用于补充日常经营所需流动资金及项目研发投入。\', first_line_indent=0.74)\\n    \\n    add_formatted_paragraph(doc,\\n        \'根据《XX银行公司授信业务管理办法》及相关规定，公司业务部指派客户经理李明辉\'\\n        \'对该公司进行全面尽职调查，形成本报告，供审批决策参考。\', first_line_indent=0.74)\\n    \\n    doc.add_heading(\'（二）调查方式\', level=2)\\n    add_formatted_paragraph(doc, \'本次尽职调查采用以下方式进行：\', first_line_indent=0.74)\\n    \\n    methods = [\\n        \'1. 实地走访：于2025年12月16日、12月20日两次赴企业经营场所进行现场调查，\'\\n        \'实地查看企业办公环境、生产设施、仓储情况等；\',\\n        \'2. 高管访谈：与公司董事长王建国、总经理张伟、财务总监刘芳等核心管理层进行深入访谈，\'\\n        \'了解企业发展战略、经营状况及融资需求；\',\\n        \'3. 资料审核：收集并审核企业营业执照、公司章程、财务报表、审计报告、纳税证明、\'\\n        \'银行流水、主要合同等相关资料；\',\\n        \'4. 外部查询：通过企业信用信息公示系统、中国裁判文书网、中国执行信息公开网、\'\\n        \'人民银行征信系统等渠道核实企业信用状况；\',\\n        \'5. 行业研究：查阅行业研究报告、政策文件，分析企业所处行业发展趋势及竞争格局。\'\\n    ]\\n    \\n    for method in methods:\\n        add_formatted_paragraph(doc, method, first_line_indent=0.74)\\n    \\n    doc.add_heading(\'（三）调查结论摘要\', level=2)\\n    add_formatted_paragraph(doc,\\n        \'经全面调查分析，智远科技是一家专注于企业级软件开发与智能化解决方案的高新技术企业，\'\\n        \'技术实力雄厚，核心团队稳定，主营业务清晰，盈利能力较强。公司近三年营业收入复合增长率达35.6%，\'\\n        \'净利润复合增长率达42.3%，财务状况良好，现金流充裕。公司在细分市场具有较强竞争优势，\'\\n        \'客户资源优质，发展前景良好。\', first_line_indent=0.74)\\n    \\n    add_formatted_paragraph(doc,\\n        \'综合评估，该公司经营规范、财务健康、信用良好、还款来源可靠，符合我行授信准入条件，\'\\n        \'建议给予综合授信额度人民币5,000万元，期限一年，具体授信方案详见本报告第十部分。\', first_line_indent=0.74)\\n    \\n    # 二、企业基本情况\\n    doc.add_page_break()\\n    doc.add_heading(\'二、企业基本情况\', level=1)\\n    \\n    doc.add_heading(\'（一）工商登记信息\', level=2)\\n    \\n    # 企业基本信息表格\\n    basic_table = doc.add_table(rows=12, cols=4)\\n    basic_table.style = \'Table Grid\'\\n    \\n    basic_data = [\\n        (\'企业名称\', \'杭州智远科技有限公司\', \'统一社会信用代码\', \'91330100MA2XXXXX\'),\\n        (\'企业类型\', \'有限责任公司\', \'成立日期\', \'2015年03月18日\'),\\n        (\'注册资本\', \'人民币5,000万元\', \'实缴资本\', \'人民币5,000万元\'),\\n        (\'法定代表人\', \'王建国\', \'联系电话\', \'0571-8888XXXX\'),\\n        (\'注册地址\', \'杭州市滨江区网商路XXX号XX大厦18层\', \'\', \'\'),\\n        (\'经营地址\', \'杭州市滨江区网商路XXX号XX大厦18-19层\', \'\', \'\'),\\n        (\'经营范围\', \'计算机软件开发、技术咨询、技术服务；信息系统集成服务；\'\\n                    \'数据处理和存储服务；人工智能技术研发及应用；电子产品销售\', \'\', \'\'),\\n        (\'营业期限\', \'2015年03月18日至长期\', \'核准日期\', \'2024年06月15日\'),\\n        (\'登记机关\', \'杭州市市场监督管理局\', \'企业状态\', \'存续（在营）\'),\\n        (\'参保人数\', \'286人\', \'纳税人资质\', \'一般纳税人\'),\\n        (\'高新技术企业\', \'是（证书编号：GR202533XXXXXX）\', \'有效期\', \'2023-2026年\'),\\n        (\'专精特新企业\', \'省级专精特新中小企业\', \'认定时间\', \'2024年05月\')\\n    ]\\n    \\n    row_idx = 0\\n    for item in basic_data:\\n        if len(item) == 4:\\n            basic_table.cell(row_idx, 0).text = item[0]\\n            basic_table.cell(row_idx, 1).text = item[1]\\n            basic_table.cell(row_idx, 2).text = item[2]\\n            basic_table.cell(row_idx, 3).text = item[3]\\n        row_idx += 1\\n    \\n    # 设置表头背景色\\n    for i