2025-12-28 15:15:25.520212 Event: <class 'pydantic_ai.messages.PartEndEvent'> PartEndEvent(index=1, part=ToolCallPart(tool_name='write_file', args='{"path": "/workspace/intermediate/create_excel_report.py", "content": "import pandas as pd\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Font, PatternFill, Alignment, Border, Side\\nfrom openpyxl.utils.dataframe import dataframe_to_rows\\nimport numpy as np\\n\\n# 读取原始数据\\nfile_path = \'/workspace/uploads/苏州市参加数币消费券活动企业汇总.xlsx\'\\ndf = pd.read_excel(file_path, header=[0,1])\\n\\n# 展平多级列名\\ndf.columns = [\'_\'.join(col).strip() if col[1] else col[0] for col in df.columns.values]\\n\\n# 删除完全为空的行\\ndf = df.dropna(how=\'all\')\\n\\n# 重置索引\\ndf = df.reset_index(drop=True)\\n\\n# 重命名列\\ncolumn_mapping = {\\n    \'苏州市参加数币消费券活动企业汇总表_序号\': \'序号\',\\n    \'苏州市参加数币消费券活动企业汇总表_地区\': \'地区\',\\n    \'苏州市参加数币消费券活动企业汇总表_企业名称\': \'企业名称\',\\n    \'苏州市参加数币消费券活动企业汇总表_店铺招牌\': \'店铺招牌\',\\n    \'苏州市参加数币消费券活动企业汇总表_类型\': \'类型\',\\n    \'苏州市参加数币消费券活动企业汇总表_地址\': \'地址\',\\n    \'苏州市参加数币消费券活动企业汇总表_备注\': \'备注\'\\n}\\n\\ndf = df.rename(columns=column_mapping)\\n\\n# 创建Excel工作簿\\nwb = Workbook()\\n\\n# 删除默认工作表\\nif \'Sheet\' in wb.sheetnames:\\n    wb.remove(wb[\'Sheet\'])\\n\\n# 创建各个分析工作表\\ndef create_summary_sheet():\\n    \\"\\"\\"创建摘要工作表\\"\\"\\"\\n    ws = wb.create_sheet(title=\\"活动摘要\\")\\n    \\n    # 添加标题\\n    ws[\'A1\'] = \\"苏州市数币消费券活动分析报告\\"\\n    ws[\'A1\'].font = Font(size=16, bold=True)\\n    \\n    # 添加摘要信息\\n    ws.append([\\"指标\\", \\"数值\\", \\"说明\\"])\\n    ws.append([\\"参与企业总数\\", len(df[\'企业名称\'].unique()), \\"参与活动的企业数量\\"])\\n    ws.append([\\"参与店铺总数\\", df[\'店铺招牌\'].nunique(), \\"参与活动的店铺数量\\"])\\n    ws.append([\\"总记录数\\", len(df), \\"活动总记录数\\"])\\n    ws.append([\\"平均参与店铺数\\", f\\"{len(df)/len(df[\'企业名称\'].unique()):.2f}\\", \\"平均每家企业参与店铺数\\"])\\n    ws.append([\\"餐饮类企业\\", df[df[\'类型\']==\'餐饮\'][\'企业名称\'].nunique(), \\"餐饮类企业数量\\"])\\n    ws.append([\\"零售类企业\\", df[df[\'类型\']==\'零售\'][\'企业名称\'].nunique(), \\"零售类企业数量\\"])\\n    \\n    # 格式化\\n    for cell in ws[1]:\\n        cell.font = Font(bold=True)\\n    \\n    # 调整列宽\\n    ws.column_dimensions[\'A\'].width = 20\\n    ws.column_dimensions[\'B\'].width = 20\\n    ws.column_dimensions[\'C\'].width = 40\\n    \\n    return ws\\n\\ndef create_enterprise_analysis_sheet():\\n    \\"\\"\\"创建企业参与分析工作表\\"\\"\\"\\n    ws = wb.create_sheet(title=\\"企业分析\\")\\n    \\n    # 企业参与度统计\\n    enterprise_shop_counts = df.groupby(\'企业名称\')[\'店铺招牌\'].nunique().sort_values(ascending=False)\\n    \\n    # 添加标题\\n    ws.append([\\"企业名称\\", \\"参与店铺数\\", \\"企业类型\\", \\"地区\\"])\\n    \\n    # 添加数据\\n    for enterprise, shop_count in enterprise_shop_counts.items():\\n        enterprise_type = df[df[\'企业名称\']==enterprise][\'类型\'].iloc[0] if len(df[df[\'企业名称\']==enterprise]) > 0 else \'未知\'\\n        region = df[df[\'企业名称\']==enterprise][\'地区\'].iloc[0] if len(df[df[\'企业名称\']==enterprise]) > 0 else \'未知\'\\n        ws.append([enterprise, shop_count, enterprise_type, region])\\n    \\n    # 格式化标题\\n    for cell in ws[1]:\\n        cell.font = Font(bold=True)\\n    \\n    # 调整列宽\\n    ws.column_dimensions[\'A\'].width = 30\\n    ws.column_dimensions[\'B\'].width = 15\\n    ws.column_dimensions[\'C\'].width = 15\\n    ws.column_dimensions[\'D\'].width = 15\\n    \\n    return ws\\n\\ndef create_detailed_stats_sheet():\\n    \\"\\"\\"创建详细统计数据工作表\\"\\"\\"\\n    ws = wb.create_sheet(title=\\"详细统计\\")\\n    \\n    # 添加标题\\n    ws.append([\\"统计维度\\", \\"数值\\", \\"百分比\\"])\\n    \\n    # 地区分布\\n    region_dist = df[\'地区\'].value_counts()\\n    for region, count in region_dist.items():\\n        percentage = (count / len(df)) * 100\\n        ws.append([f\\"地区: {region}\\", count, f\\"{percentage:.1f}%\\"])\\n    \\n    # 类型分布\\n    type_dist = df[\'类型\'].value_counts()\\n    for type_name, count in type_dist.items():\\n        percentage = (count / len(df)) * 100\\n        ws.append([f\\"类型: {type_name}\\", count, f\\"{percentage:.1f}%\\"])\\n    \\n    # 企业参与度分布\\n    enterprise_shop_counts = df.groupby(\'企业名称\')[\'店铺招牌\'].nunique()\\n    shop_dist = enterprise_shop_counts.value_counts().sort_index()\\n    \\n    for shop_count, enterprise_count in shop_dist.items():\\n        percentage = (enterprise_count / len(df[\'企业名称\'].unique())) * 100\\n        ws.append([f\\"企业参与店铺数: {shop_count}家\\", enterprise_count, f\\"{percentage:.1f}%\\"])\\n    \\n    # 格式化标题\\n    for cell in ws[1]:\\n        cell.font = Font(bold=True)\\n    \\n    # 调整列宽\\n    ws.column_dimensions[\'A\'].width = 25\\n    ws.column_dimensions[\'B\'].width = 15\\n    ws.column_dimensions[\'C\'].width = 15\\n    \\n    return ws\\n\\ndef create_top_enterprises_sheet():\\n    \\"\\"\\"创建重点企业分析工作表\\"\\"\\"\\n    ws = wb.create_sheet(title=\\"重点企业\\")\\n    \\n    # 添加标题\\n    ws.append([\\"排名\\", \\"企业名称\\", \\"参与店铺数\\", \\"企业类型\\", \\"平均店铺数\\"])\\n    \\n    # 计算每个企业的参与店铺数\\n    enterprise_shop_counts = df.groupby(\'企业名称\')[\'店铺招牌\'].nunique().sort_values(ascending=False)\\n    \\n    # 添加数据\\n    for i, (enterprise, shop_count) in enumerate(enterprise_shop_counts.head(10).items(), 1):\\n        enterprise_type = df[df[\'企业名称\']==enterprise][\'类型\'].iloc[0] if len(df[df[\'企业名称\']==enterprise]) > 0 else \'未知\'\\n        avg_shops = shop_count  # 这里简化处理\\n        ws.append([i, enterprise, shop_count, enterprise_type, avg_shops])\\n    \\n    # 格式化标题\\n    for cell in ws[1]:\\n        cell.font = Font(bold=True)\\n    \\n    # 调整列宽\\n    ws.column_dimensions[\'A\'].width = 10\\n    ws.column_dimensions[\'B\'].width = 30\\n    ws.column_dimensions[\'C\'].width = 15\\n    ws.column_dimensions[\'D\'].width = 15\\n    ws.column_dimensions[\'E\'].width = 15\\n    \\n    return ws\\n\\n# 创建所有工作表\\ncreate_summary_sheet()\\ncreate_enterprise_analysis_sheet()\\ncreate_detailed_stats_sheet()\\ncreate_top_enterprises_sheet()\\n\\n# 保存文件\\noutput_file = \\"/workspace/intermediate/苏州市数币消费券活动分析报告.xlsx\\"\\nwb.save(output_file)\\n\\nprint(f\\"Excel分析报告已保存至: {output_file}\\")"}', tool_call_id='call_38e2f7b222ea434a80712e6b'))
