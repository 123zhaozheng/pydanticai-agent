\'调查期间：2025年12月15日至2025年12月28日\',\\n        f\'报告日期：{datetime.datetime.now().strftime(\\"%Y年%m月%d日\\")}\'\\n    ]\\n    for line in info:\\n        p = doc.add_paragraph()\\n        r = p.add_run(line)\\n        r.font.size = Pt(12)\\n        p.alignment = WD_ALIGN_PARAGRAPH.CENTER\\n    \\n    for _ in range(6):\\n        doc.add_paragraph()\\n    \\n    # 编制信息\\n    footer_info = [\\n        \'编制部门：公司业务部\',\\n        \'调查人员：李明辉（客户经理）\',\\n        \'复核人员：陈志强（业务主管）\'\\n    ]\\n    for line in footer_info:\\n        p = doc.add_paragraph()\\n        r = p.add_run(line)\\n        r.font.size = Pt(14)\\n        p.alignment = WD_ALIGN_PARAGRAPH.CENTER\\n\\ndef create_toc(doc):\\n    \\"\\"\\"创建目录\\"\\"\\"\\n    doc.add_page_break()\\n    p = doc.add_paragraph()\\n    r = p.add_run(\'目    录\')\\n    r.font.size = Pt(18)\\n    r.font.bold = True\\n    p.alignment = WD_ALIGN_PARAGRAPH.CENTER\\n    p.paragraph_format.space_after = Pt(24)\\n    \\n    toc = [\\n        \'一、调查概述\',\\n        \'二、企业基本情况\',\\n        \'三、股权结构与关联企业\',\\n        \'四、经营情况分析\',\\n        \'五、财务状况分析\',\\n        \'六、银行往来及信用记录\',\\n        \'七、行业分析与市场地位\',\\n        \'八、风险分析与评估\',\\n        \'九、担保措施分析\',\\n        \'十、综合评价与授信建议\',\\n        \'附件清单\'\\n    ]\\n    for item in toc:\\n        p = doc.add_paragraph(item)\\n        p.paragraph_format.space_after = Pt(12)\\n\\ndef create_section1(doc):\\n    \\"\\"\\"一、调查概述\\"\\"\\"\\n    doc.add_page_break()\\n    doc.add_heading(\'一、调查概述\', level=1)\\n    \\n    doc.add_heading(\'（一）调查背景\', level=2)\\n    add_para(doc, \\n        \'杭州智远科技有限公司（以下简称\\"智远科技\\"或\\"该公司\\"）系我行存量优质客户，\'\\n        \'自2019年与我行建立业务合作关系以来，双方合作良好，客户信用记录优良。\'\\n        \'该公司主要从事企业级软件开发与智能化解决方案业务，是浙江省\\"专精特新\\"中小企业，\'\\n        \'国家高新技术企业。\')\\n    \\n    add_para(doc,\\n        \'近期，该公司因业务快速发展，承接了多个大型项目，拟向我行申请综合授信额度人民币5,000万元，\'\\n        \'其中流动资金贷款额度3,000万元，银行承兑汇票额度1,500万元，保函额度500万元，\'\\n        \'主要用于补充日常经营所需流动资金、项目研发投入及业务拓展。\')\\n    \\n    add_para(doc,\\n        \'根据《XX银行公司授信业务管理办法》《XX银行信贷尽职调查工作指引》及相关规定，\'\\n        \'公司业务部指派客户经理李明辉对该公司进行全面尽职调查，形成本报告，供审批决策参考。\')\\n    \\n    doc.add_heading(\'（二）调查方式与过程\', level=2)\\n    add_para(doc, \'本次尽职调查历时14天，采用以下方式进行：\')\\n    \\n    methods = [\\n        \'1. 实地走访：于2025年12月16日、12月20日、12月25日三次赴企业经营场所进行现场调查，\'\\n        \'实地查看企业办公环境、研发中心、机房设施、员工工作状态等，核实企业实际经营情况；\',\\n        \\n        \'2. 高管访谈：与公司董事长王建国、总经理张伟、财务总监刘芳、技术总监李强等核心管理层\'\\n        \'进行深入访谈，详细了解企业发展历程、战略规划、经营状况、融资需求及还款安排；\',\\n        \\n        \'3. 资料审核：收集并审核企业营业执照、公司章程、股东会决议、财务报表（2022-2024年度）、\'\\n        \'审计报告、纳税证明、银行流水、主要业务合同、知识产权证书等相关资料，核实信息真实性；\',\\n        \\n        \'4. 外部查询：通过国家企业信用信息公示系统、中国裁判文书网、中国执行信息公开网、\'\\n        \'全国法院失信被执行人名单、人民银行征信系统、税务系统等渠道全面核查企业及关联方信用状况；\',\\n        \\n        \'5. 行业研究：查阅中国软件行业协会报告、工信部政策文件、券商研究报告等，\'\\n        \'深入分析企业所处行业发展趋势、竞争格局及政策环境；\',\\n        \\n        \'6. 客户走访：电话回访企业主要客户3家，了解业务合作情况及客户评价。\'\\n    ]\\n    for m in methods:\\n        add_para(doc, m)\\n\\ndef create_section1_continued(doc):\\n    \\"\\"\\"一、调查概述（续）\\"\\"\\"\\n    doc.add_heading(\'（三）调查结论摘要\', level=2)\\n    \\n    add_para(doc,\\n        \'经全面深入调查分析，现将主要调查结论汇报如下：\')\\n    \\n    conclusions = [\\n        \'1. 企业资质优良：智远科技是一家专注于企业级软件开发与智能化解决方案的高新技术企业，\'\\n        \'拥有国家高新技术企业认定、浙江省\\"专精特新\\"中小企业认定，具备软件企业认定证书、\'\\n        \'ISO9001质量管理体系认证、ISO27001信息安全管理体系认证等多项资质，企业规范运营。\',\\n        \\n        \'2. 技术实力雄厚：公司拥有研发人员156人，占员工总数54.5%，累计获得软件著作权68项、\'\\n        \'发明专利12项、实用新型专利23项。核心产品\\"智远ERP系统\\"、\\"智远MES系统\\"在细分市场\'\\n        \'具有较强竞争力，技术壁垒较高。\',\\n        \\n        \'3. 经营业绩优秀：公司近三年营业收入分别为1.28亿元、1.76亿元、2.35亿元，\'\\n        \'复合增长率35.6%；净利润分别为1,520万元、2,180万元、3,080万元，复合增长率42.3%。\'\\n        \'2024年1-11月实现营业收入2.68亿元，同比增长32.5%，预计全年可达2.95亿元。\',\\n        \\n        \'4. 财务状况健康：截至2024年11月末，公司总资产3.86亿元，净资产1.92亿元，\'\\n        \'资产负债率50.3%，流动比率1.85，速动比率1.62，各项财务指标处于行业优良水平。\'\\n        \'公司现金流充裕，经营性现金流净额持续为正。\',\\n        \\n        \'5. 信用记录良好：企业及实际控制人征信记录良好，无不良贷款记录，无重大诉讼纠纷，\'\\n        \'无行政处罚记录，纳税信用等级为A级，在我行历史合作中从未发生逾期。\',\\n        \