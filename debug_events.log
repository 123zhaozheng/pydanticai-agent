n        print(f\\"      {i}. {row[\'问题原因\']} (计划: {row[\'计划时间\'].strftime(\'%Y-%m-%d\') if pd.notna(row[\'计划时间\']) else \'待定\'})\\")\\n\\nprint(\\"\\\\n\\" + \\"=\\" * 80)\\nprint(\\"📈 关键绩效指标 (KPI)\\")\\nprint(\\"=\\" * 80)\\n\\n# 计算综合KPI\\nkpi_metrics = {}\\n\\n# 解决率\\nif with_status > 0:\\n    kpi_metrics[\'问题解决率\'] = solved / with_status * 100\\n\\n# 时间效率\\nif len(valid_time_diffs) > 0:\\n    kpi_metrics[\'按时完成率\'] = (valid_time_diffs <= 0).sum() / len(valid_time_diffs) * 100\\n    kpi_metrics[\'平均解决时间\'] = abs(valid_time_diffs).mean()\\n\\n# 数据质量\\nkpi_metrics[\'数据完整性\'] = np.mean(list(data_completeness.values()))\\nkpi_metrics[\'状态跟踪率\'] = data_completeness[\'状态\']\\n\\n# 整体效率评分\\nefficiency_score = (\\n    kpi_metrics.get(\'问题解决率\', 0) * 0.3 +\\n    kpi_metrics.get(\'按时完成率\', 0) * 0.3 +\\n    kpi_metrics.get(\'数据完整性\', 0) * 0.2 +\\n    kpi_metrics.get(\'状态跟踪率\', 0) * 0.2\\n)\\nkpi_metrics[\'综合效率评分\'] = efficiency_score\\n\\nprint(\\"\\\\n📊 关键指标概览:\\")\\nfor metric, value in kpi_metrics.items():\\n    if isinstance(value, float):\\n        print(f\\"   • {metric}: {value:.1f}%\\")\\n    else:\\n        print(f\\"   • {metric}: {value}\\")\\n\\nprint(f\\"\\\\n🏆 综合效率评分: {efficiency_score:.1f}/100\\")\\n\\nprint(\\"\\\\n\\" + \\"=\\" * 80)\\nprint(\\"📋 改进建议\\")\\nprint(\\"=\\" * 80)\\n\\nprint(\\"\\\\n🔧 立即改进项:\\")\\nprint(\\"   1. 加强数据记录完整性，特别是状态跟踪（当前仅50%）\\")\\nprint(\\"   2. 建立问题分类标准化流程，确保分类一致性\\")\\nprint(\\"   3. 完善时间预估机制，提高时间准确性\\")\\nprint(\\"   4. 建立高严重程度问题的快速响应机制\\")\\n\\nprint(\\"\\\\n📈 短期优化项:\\")\\nprint(\\"   1. 针对应用缺陷类问题（40%）制定专项解决方案\\")\\nprint(\\"   2. 优化知识库管理流程，解决相关问题（30%）\\")\\nprint(\\"   3. 建立定期数据清理和维护机制\\")\\nprint(\\"   4. 完善问题跟踪和状态更新流程\\")\\n\\nprint(\\"\\\\n🚀 长期战略项:\\")\\nprint(\\"   1. 构建知识库，沉淀解决方案和最佳实践\\")\\nprint(\\"   2. 建立问题预警机制，提前发现潜在问题\\")\\nprint(\\"   3. 优化团队协作流程，提高处理效率\\")\\nprint(\\"   4. 建立持续改进的数据驱动决策机制\\")\\n\\nprint(\\"\\\\n🎯 优先级建议:\\")\\nprint(\\"   🔴 高优先级: 状态数据完整性、高严重程度问题处理\\")\\nprint(\\"   🟡 中优先级: 应用缺陷解决方案、时间管理优化\\")\\nprin