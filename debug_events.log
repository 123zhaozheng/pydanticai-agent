2025-12-29 11:07:42.027457 Event: <class 'pydantic_ai.messages.PartStartEvent'> PartStartEvent(index=2, part=ToolCallPart(tool_name='write_file', args='{"path":"/workspace/intermediate/status_distribution_analysis.py","content":"import pandas as pd\\nimport numpy as np\\nfrom collections import Counter\\n\\n# 设置文件路径\\nfile_path = \'/workspace/uploads/昆小智问题处理计划.xlsx\'\\n\\n# 读取数据\\ndf = pd.read_excel(file_path, sheet_name=\'Sheet1\')\\n\\nprint(\\"=== 状态分布和完成率分析 ===\\\\n\\")\\n\\n# 1. 基本数据概览\\nprint(\\"1. 基本数据概览:\\")\\nprint(f\\"总记录数: {len(df)}\\")\\nprint(f\\"状态字段有效值: {df[\'状态\'].notna().sum()}个\\")\\nprint(f\\"状态字段缺失值: {df[\'状态\'].isna().sum()}个\\")\\nprint(f\\"状态完整率: {df[\'状态\'].notna().sum() / len(df) * 100:.1f}%\\\\n\\")\\n\\n# 2. 状态分布分析\\nprint(\\"2. 状态分布分析:\\")\\n\\n# 分析已知状态\\nstatus_counts = df[\'状态\'].value_counts()\\nprint(\\"已知状态分布:\\")\\nfor status, count in status_counts.items():\\n    percentage = count / len(df) * 100\\n    print(f\\"  {status}: {count}个 ({percentage:.1f}%)\\")\\n\\n# 分析缺失状态\\nmissing_count = df[\'状态\'].isna().sum()\\nif missing_count > 0:\\n    print(f\\"  未指定状态: {missing_count}个 ({missing_count/len(df)*100:.1f}%)\\")\\n\\n# 3. 完成率分析\\nprint(f\\"\\\\n3. 完成率分析:\\")\\n\\n# 定义完成状态\\ncompleted_statuses = [\'已解决\', \'已完成\', \'完成\', \'done\', \'finished\']\\nin_progress_statuses = [\'在处理\', \'处理中\', \'进行中\', \'in_progress\', \'pending\']\\nnot_started_statuses = [\'未开始\', \'pending\', \'未处理\']\\n\\n# 标准化状态\\ndef normalize_status(status):\\n    if pd.isna(status):\\n        return \'未知\'\\n    status = str(status).strip().lower()\\n    \\n    for completed in completed_statuses:\\n        if completed in status:\\n            return \'已完成\'\\n    \\n    for in_progress in in_progress_statuses:\\n        if in_progress in status:\\n            return \'进行中\'\\n    \\n    for not_started in not_started_statuses:\\n        if not_started in status:\\n            return \'未开始\'\\n    \\n    return \'其他\'\\n\\n# 标准化状态\\ndf[\'标准化状态\'] = df[\'状态\'].apply(normalize_status)\\n\\n# 统计各状态\\nstatus_distribution = df[\'标准化状态\'].value_counts()\\nprint(\\"标准化状态分布:\\")\\nfor status, count in status_distribution.items():\\n    percentage = count / len(df) * 100\\n    print(f\\"  {status}: {count}个 ({percentage:.1f}%)\\")\\n\\n# 计算完成率\\ncompleted_count = len(df[df[\'标准化状态\'] == \'已完成\'])\\nin_progress_count = len(df[df[\'标准化状态\'] == \'进行中\'])\\nnot_started_count = len(df[df[\'标准化状态\'] == \'未开始\'])\\nother_count = len(df[df[\'标准化状态\'] == \'其他\'])\\nunknown_count = len(df[df[\'标准化状态\'] == \'未知\'])\\n\\ncompletion_rate = completed_count / len(df) * 100\\nprogress_rate = in_progress_count / len(df) * 100\\n\\nprint(f\\"\\\\n完成率统计:\\")\\nprint(f\\"  已完成: {completed_count}个 ({completion_rate:.1f}%)\\")\\nprint(f\\"  进行中: {in_progress_count}个 ({progress_rate:.1f}%)\\")\\nprint(f\\"  未开始: {not_started_count}个 ({not_started_count/len(df)*100:.1f}%)\\")\\nprint(f\\"  其他状态: {other_count}个 ({other_count/len(df)*100:.1f}%)\\")\\nprint(f\\"  未知状态: {unknown_count}个 ({unknown_count/len(df)*100:.1f}%)\\")\\n\\n# 4. 状态与时间关联分析\\nprint(f\\"\\\\n4. 状态与时间关联分析:\\")\\n\\n# 计算各状态的时间特征\\nstatus_time_analysis = []\\nfor status in df[\'标准化状态\'].unique():\\n    status_df = df[df[\'标准化状态\'] == status]\\n    \\n    # 计划时间完整性\\n    plan_completeness = status_df[\'计划时间\'].notna().sum() / len(status_df) * 100 if len(status_df) > 0 else 0\\n    \\n    # 实际解决时间完整性  \\n    actual_completeness = status_df[\'实际解决时间\'].notna().sum() / len(status_df) * 100 if len(status_df) > 0 else 0\\n    \\n    status_time_analysis.append({\\n        \'状态\': status,\\n        \'记录数\': len(status_df),\\n        \'计划时间完整率\': plan_completeness,\\n        \'实际解决时间完整率\': actual_completeness\\n    })\\n\\nprint(\\"各状态时间数据完整性:\\")\\nfor analysis in status_time_analysis:\\n    print(f\\"  {analysis[\'状态\']}: {analysis[\'记录数\']}个记录, \\"\\n          f\\"计划时间完整率{analysis[\'计划时间完整率\']:.1f}%, \\"\\n          f\\"实际解决时间完整率{analysis[\'实际解决时间完整率\']:.1f}%\\")\\n\\n# 5. 状态与问题类型关联分析\\nprint(f\\"\\\\n5. 状态与问题类型关联分析:\\")\\n\\n# 添加问题分类\\ndef classify_problem_type(reason):\\n    reason = str(reason).lower()\\n    if any(keyword in reason for keyword in [\'浏览器\']):\\n        return \'浏览器问题\'\\n    elif any(keyword in reason for keyword in [\'模型\']):\\n        return \'模型问题\'\\n    elif any(keyword in reason for keyword in [\'应用缺陷\']):\\n        return \'应用缺陷\'\\n    elif any(keyword in reason for keyword in [\'知识库\']):\\n        return \'知识库问题\'\\n    elif any(keyword in reason for keyword in [\'登录\']):\\n        return \'登录问题\'\\n    else:\\n        return \'其他问题\'\\n\\ndf[\'问题类型\'] = df[\'问题原因\'].apply(classify_problem_type)\\n\\n# 分析状态与问题类型的关系\\nprint(\\"状态与问题类型交叉分析:\\")\\nfor problem_type in df[\'问题类型\'].unique():\\n    type_df = df[df[\'问题类型\'] == problem_type]\\n    if len(type_df) > 0:\\n        status_dist = type_df[\'标准化状态\'].value_counts()\\n        print(f\\"\\\\n{problem_type} ({len(type_df)}个):\\")\\n        for status, count in status_dist.items():\\n            percentage = count / len(type_df) * 100\\n            print(f\\"  {status}: {count}个 ({percentage:.1f}%)\\")\\n\\n# 6. 完成率趋势分析\\nprint(f\\"\\\\n6. 完成率趋势分析:\\")\\n\\n# 按序号分析（假设序号代表处理顺序）\\nprint(\\"按处理顺序的完成状态:\\")\\nfor i in range(len(df)):\\n    row = df.iloc[i]\\n    print(f\\"  序号{row[\'序号\']}: {row[\'问题原因\'][:30]}... - 状态: {row[\'标准化状态\']}\\")\\n\\n# 计算累计完成率\\ncumulative_completion = []\\ncompleted_so_far = 0\\nfor i in range(len(df)):\\n    if df.iloc[i][\'标准化状态\'] == \'已完成\':\\n        completed_so_far += 1\\n    cumulative_completion.append(completed_so_far / (i + 1) * 100)\\n\\nprint(f\\"\\\\n累计完成率变化:\\")\\nfor i, rate in enumerate(cumulative_completion):\\n    print(f\\"  第{i+1}个问题后: {rate:.1f}%\\")\\n\\n# 7. 问题状态矩阵\\nprint(f\\"\\\\n7. 问题状态矩阵:\\")\\n\\n# 创建状态-问题类型矩阵\\nstatus_matrix = pd.crosstab(df[\'问题类型\'], df[\'标准化状态\'], margins=True)\\nprint(\\"状态-问题类型矩阵:\\")\\nprint(status_matrix)\\n\\n# 8. 关键指标计算\\nprint(f\\"\\\\n8. 关键指标计算:\\")\\n\\n# KPI指标\\ntotal_issues = len(df)\\ncompleted_issues = len(df[df[\'标准化状态\'] == \'已完成\'])\\nin_progress_issues = len(df[df[\'标准化状态\'] == \'进行中\'])\\npending_issues = len(df[df[\'标准化状态\'] == \'未开始\'])\\n\\n# 计算各种完成率\\noverall_completion_rate = completed_issues / total_issues * 100\\nactive_completion_rate = completed_issues / (completed_issues + in_progress_issues) * 100 if (completed_issues + in_progress_issues) > 0 else 0\\n\\nprint(f\\"总体完成率: {overall_completion_rate:.1f}% ({completed_issues}/{total_issues})\\")\\nprint(f\\"活跃完成率: {active_completion_rate:.1f}% (仅计算已完成和进行中)\\")\\nprint(f\\"问题密度: {total_issues}个问题\\")\\n\\n# 计算处理效率指数\\nefficiency_index = (completed_issues * 2 + in_progress_issues) / total_issues * 100\\nprint(f\\"处理效率指数: {efficiency_index:.1f}\\")\\n\\n# 9. 风险评估\\nprint(f\\"\\\\n9. 风险评估:\\")\\n\\n# 计算各风险指标\\nrisk_factors = {\\n    \'状态缺失风险\': df[\'状态\'].isna().sum() / total_issues * 100,\\n    \'未开始问题风险\': pending_issues / total_issues * 100,\\n    \'进行中问题占比\': in_progress_issues / total_issues * 100,\\n    \'完成率风险\': (100 - overall_completion_rate)\\n}\\n\\nprint(\\"风险评估结果:\\")\\nfor risk_type, risk_value in risk_factors.items():\\n    risk_level = \\"低\\" if risk_value < 20 else \\"中\\" if risk_value < 50 else \\"高\\"\\n    print(f\\"  {risk_type}: {risk_value:.1f}% (风险等级: {risk_level})\\")\\n\\n# 综合风险评估\\noverall_risk = sum(risk_factors.values()) / len(risk_factors)\\noverall_risk_level = \\"低\\" if overall_risk < 20 else \\"中\\" if overall_risk < 50 else \\"高\\"\\nprint(f\\"\\\\n综合风险评估: {overall_risk:.1f}% (风险等级: {overall_risk_level})\\")\\n\\n# 10. 改进建议\\nprint(f\\"\\\\n10. 改进建议:\\")\\n\\nif overall_completion_rate < 50:\\n    print(\\"  • 急需提高问题完成率，建议优先处理积压问题\\")\\nif df[\'状态\'].isna().sum() / total_issues > 30:\\n    print(\\"  • 状态记录不完整，建议建立状态跟踪机制\\")\\nif in_progress_issues / total_issues > 40:\\n    print(\\"  • 进行中问题过多，建议优化资源分配\\")\\nif pending_issues / total_issues > 20:\\n    print(\\"  • 存在较多未开始问题，建议启动问题评估机制\\")\\n\\nprint(\\"  • 建立定期状态更新机制\\")\\nprint(\\"  • 优化问题分类和优先级管理\\")\\nprint(\\"  • 建立问题状态预警系统\\")\\n\\nprint(f\\"\\\\n=== 状态分布和完成率分析完成 ===\\")"}', tool_call_id='call_41deb7cf3c6f4583b38caed2'), previous_part_kind='text')
