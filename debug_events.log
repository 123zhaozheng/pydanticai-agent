6, weight=\'bold\', pad=20)\\n\\n# 数据概览文本\\noverview_text = f\\"\\"\\"\\n数据概览\\n========================\\n总问题数量: {len(df):,}\\n分析时间范围: {df[\'提交时间\'].min().strftime(\'%Y-%m-%d\')} 至 {df[\'提交时间\'].max().strftime(\'%Y-%m-%d\')}\\n数据完整度: {(1 - df.isnull().sum().sum() / (len(df) * len(df.columns))) * 100:.1f}%\\n\\n主要列信息:\\n- 用户: {df[\'用户\'].nunique()} 个不同用户\\n- 问题类型: {df[\'问题类型\'].nunique()} 种类型\\n- 来源: {df[\'来源\'].nunique()} 种来源\\n- 提出人: {df[\'提出人\'].nunique()} 人\\n\\"\\"\\"\\n\\nplt.text(0.05, 0.95, overview_text, transform=plt.gca().transAxes, \\n         fontsize=12, verticalalignment=\'top\', fontfamily=\'monospace\')\\nplt.tight_layout()\\npdf_pages.savefig(plt.gcf(), dpi=300, bbox_inches=\'tight\')\\n\\n# 3. 用户活跃度分析\\nplt.figure(figsize=(fig_width, fig_height))\\nplt.subplot(2, 1, 1)\\nuser_stats = df[\'用户\'].value_counts().head(10)\\nplt.barh(range(len(user_stats)), user_stats.values, color=\'skyblue\')\\nplt.yticks(range(len(user_stats)), user_stats.index)\\nplt.xlabel(\'问题提交数量\')\\nplt.title(\'TOP10 用户问题提交活跃度\', fontsize=16, weight=\'bold\')\\nplt.tight_layout()\\npdf_pages.savefig(plt.gcf(), dpi=300, bbox_inches=\'tight\')\\n\\n# 4. 问题类型分析\\nplt.figure(figsize=(fig_width, fig_height))\\nplt.subplot(2, 1, 1)\\ntype_stats = df[\'问题类型\'].value_counts().head(10)\\nplt.pie(type_stats.values, labels=type_stats.index, autopct=\'%1.1f%%\', startangle=90)\\nplt.title(\'问题类型分布 (TOP10)\', fontsize=16, weight=\'bold\')\\nplt.tight_layout()\\npdf_pages.savefig(plt.gcf(), dpi=300, bbox_inches=\'tight\')\\n\\n# 5. 时间趋势分析\\nplt.figure(figsize=(fig_width, fig_height))\\nplt.subplot(2, 1, 1)\\ndaily_stats = df[\'日期\'].value_counts().sort_index()\\nplt.plot(daily_stats.index, daily_stats.values, marker=\'o\', linewidth=2, markersize=6)\\nplt.xlabel(\'日期\')\\nplt.ylabel(\'问题数量\')\\nplt.title(\'每日问题提交趋势\', fontsize=16, weight=\'bold\')\\nplt.xticks(rotation=45)\\nplt.grid(True, alpha=0.3)\\nplt.tight_layout()\\npdf_pages.savefig(plt.gcf(), dpi=300, bbox_inches=\'tight\')\\n\\n# 6. 来源分布\\nplt.figure(figsize=(fig_width, fig_height))\\nplt.subplot(2, 1, 1)\\nsource_stats = df[\'来源\'].value_counts()\\nplt.bar(source_stats.index, source_stats.values, color=\'lightcoral\')\\nplt.xlabel(\'来源\')\\nplt.ylabel(\'数量\')\\nplt.title(\'问题来源分布\', fontsize=16, weight=\'bold\')\\nplt.tight_layout()\\npdf_pages.savefig(plt.gcf(), dpi=300, bbox_inches=\'tight\')\\n\\n# 7. 提出人分布\\nplt.figure(figsize=(fig_width, fig_height))\\nplt.subplot(2, 1, 1)\\nsubmitter_stats = df[\'提出人\'].value_counts().head(10)\\nplt.barh(range(len(submitter_stats)), submitter_stats.values, color=\'lightgreen\')\\nplt.yticks(range(len(submitter_stats)), submitter_stats.index)\\nplt.xlabel(\'问题提出数量\')\\nplt.title(\'TOP10 问题提出人\', fontsize=16, weight=\'bold\')\\nplt.tight_layout()\\npdf_pages.savefig(plt.gcf(), dpi=300, bbox_inches=\'tight\')\\n\\n# 8. 详细统计表格\\nplt.figure(figsize=(fig_width, fig_height))\\nplt.subplot(2, 1, 1)\\nplt.axis(\'off\')\\nplt.title(\'详细统计分析\', fontsize=16, weight=\'bold\', pad=20)\\n\\n# 创建统计表格文本\\nstats_text = f\\"\\"\\"\\n详细统计分析\\n========================\\n\\n用户活跃度 (TOP10):\\n{user_stats.to_string()}\\n\\n问题来源分布:\\n{source_stats.to_string()}\\n\\n问题类型分布 (TOP10):\\n{type_stats.head(10).to_string()}\\n\\n每日问题提交统计 (前10天):\\n{daily_stats.head(10).to_string()}\\n\\"\\"\\"\\n\\nplt.text(0.05, 0.95, stats_text, transform=plt.gca().transAxes, \\n         fontsize=10, verticalalignment=\'top\', fontfamily=\'monospace\')\\nplt.tight_layout()\\npdf_pages.savefig(plt.gcf(), dpi=300, bbox_inches=\'tight\')\\n\\n# 9. 数据质量分析\\nplt.figure(figsize=(fig_width, fig_height))\\nplt.subplot(2, 1, 1)\\nplt.axis(\'off\')\\nplt.title(\'数据质量分析\', fontsize=16, weight=\'bold\', pad=20)\\n\\n# 数据质量分析\\nmissing_data = df.isnull().sum()\\nmissing_percent = (missing_data / len(df) * 100).round(1)\\nquality_text = f\\"\\"\\"\\n数据质量分析\\n========================\\n\\n缺失值统计:\\n{missing_data.to_string()}\\n\\n缺失值百分比 (%):\\n{missing_percent.to_string()}\\n\\n数据完整性评估:\\n- 关键字段 (用户、提交时间、原始问题): 100% 完整\\n- 可选字段 (来源): {(1 - missing_data[\'来源\']/len(df))*100:.1f}% 完整\\n- 其他字段: 大部分为空，可能是待补充信息\\n\\"\\"\\"\\n\\nplt.text(0.05, 0.95, quality_text, transform=plt.gca().transAxes, \\n         fontsize=10, verticalalignment=\'top\', fontfamily=\'monospace\')\\nplt.tight_layout()\\npdf_pages.savefig(plt.gcf(), dpi=300, bbox_inches=\'tight\')\\n\\n# 关闭PDF文件\\npdf_pages.close()\\n\\nprint(f\\"PDF报告已生成: {pdf_filename}\\")\\nprint(f\\"报告包含 {10} 页分析内容\\")\\nprint(\\"报告内容:\\")\\nprint(\\"1. 封面页\\")\\nprint(\\"2. 数据概览\\")\\nprint(\\"3. 用户活跃度分析\\")\\nprint(\\"4. 问题类型分析\\")\\nprint(\\"5. 时间趋势分析\\")\\nprint(\\"6. 来源分布\\")\\nprint(\\"7. 提出人分布\\")\\nprint(\\"8. 详细统计分析\\")\\nprint(\\"9. 数据质量分析\\")"}', tool_call_id='call_ef754531bd4d4a5084c8a760'), previous_part_kind='text')
