2025-12-29 15:56:01.019309 Event: <class 'pydantic_ai.messages.PartEndEvent'> PartEndEvent(index=0, part=TextPart(content='# Go 语言详细讲解\n\nGo（又称 Golang）是 Google 于 2009 年发布的一门开源编程语言，由 Robert Griesemer、Rob Pike 和 Ken Thompson 设计。它以简洁、高效、并发支持强大而著称。\n\n---\n\n## 1. 基础语法\n\n### 1.1 Hello World\n\n```go\npackage main\n\nimport "fmt"\n\nfunc main() {\n    fmt.Println("Hello, World!")\n}\n```\n\n- `package main`：声明主包，可执行程序必须有 main 包\n- `import "fmt"`：导入标准库的 fmt 包\n- `func main()`：程序入口函数\n\n### 1.2 变量声明\n\n```go\n// 方式1：完整声明\nvar name string = "Alice"\n\n// 方式2：类型推断\nvar age = 25\n\n// 方式3：短变量声明（只能在函数内使用）\nscore := 100\n\n// 多变量声明\nvar a, b, c int = 1, 2, 3\nx, y := "hello", 42\n\n// 常量\nconst Pi = 3.14159\nconst (\n    StatusOK = 200\n    StatusNotFound = 404\n)\n```\n\n### 1.3 基本数据类型\n\n```go\n// 数值类型\nvar i int = 42           // int, int8, int16, int32, int64\nvar u uint = 42          // uint, uint8, uint16, uint32, uint64\nvar f float64 = 3.14     // float32, float64\nvar c complex128 = 1+2i  // complex64, complex128\n\n// 布尔类型\nvar b bool = true\n\n// 字符串\nvar s string = "Hello"\n\n// 字节和字符\nvar byte1 byte = \'A\'     // uint8 的别名\nvar rune1 rune = \'中\'    // int32 的别名，表示 Unicode 码点\n```\n\n---\n\n## 2. 控制结构\n\n### 2.1 条件语句\n\n```go\n// if-else\nif x > 0 {\n    fmt.Println("正数")\n} else if x < 0 {\n    fmt.Println("负数")\n} else {\n    fmt.Println("零")\n}\n\n// if 带初始化语句\nif err := doSomething(); err != nil {\n    fmt.Println("出错了:", err)\n}\n\n// switch\nswitch day {\ncase "Monday":\n    fmt.Println("周一")\ncase "Tuesday", "Wednesday":\n    fmt.Println("周二或周三")\ndefault:\n    fmt.Println("其他")\n}\n\n// switch 无条件（替代 if-else 链）\nswitch {\ncase score >= 90:\n    fmt.Println("优秀")\ncase score >= 60:\n    fmt.Println("及格")\ndefault:\n    fmt.Println("不及格")\n}\n```\n\n### 2.2 循环\n\nGo 只有 `for` 一种循环结构：\n\n```go\n// 标准 for 循环\nfor i := 0; i < 10; i++ {\n    fmt.Println(i)\n}\n\n// while 风格\ni := 0\nfor i < 10 {\n    fmt.Println(i)\n    i++\n}\n\n// 无限循环\nfor {\n    // 使用 break 退出\n    if condition {\n        break\n    }\n}\n\n// 遍历数组/切片/map\nnums := []int{1, 2, 3}\nfor index, value := range nums {\n    fmt.Printf("索引: %d, 值: %d\\n", index, value)\n}\n\n// 只要值，忽略索引\nfor _, value := range nums {\n    fmt.Println(value)\n}\n```\n\n---\n\n## 3. 复合数据类型\n\n### 3.1 数组\n\n```go\n// 固定长度\nvar arr [5]int = [5]int{1, 2, 3, 4, 5}\narr2 := [...]int{1, 2, 3}  // 编译器推断长度\n\nfmt.Println(arr[0])   // 访问元素\nfmt.Println(len(arr)) // 长度\n```\n\n### 3.2 切片（Slice）\n\n```go\n// 切片是动态数组\nslice := []int{1, 2, 3}\n\n// 从数组创建切片\narr := [5]int{1, 2, 3, 4, 5}\nslice := arr[1:4]  // [2, 3, 4]\n\n// make 创建切片\nslice := make([]int, 5)      // 长度5，容量5\nslice := make([]int, 5, 10)  // 长度5，容量10\n\n// 追加元素\nslice = append(slice, 6, 7, 8)\n\n// 切片操作\nslice[0:3]  // 前3个元素\nslice[:3]   // 同上\nslice[2:]   // 从索引2到末尾\nslice[:]    // 整个切片\n```\n\n### 3.3 Map\n\n```go\n// 创建 map\nm := make(map[string]int)\nm["apple"] = 5\nm["banana"] = 3\n\n// 字面量初始化\nm := map[string]int{\n    "apple":  5,\n    "banana": 3,\n}\n\n// 访问\nvalue := m["apple"]\n\n// 检查键是否存在\nvalue, exists := m["orange"]\nif exists {\n    fmt.Println(value)\n}\n\n// 删除\ndelete(m, "apple")\n\n// 遍历\nfor key, value := range m {\n    fmt.Printf("%s: %d\\n", key, value)\n}\n```\n\n### 3.4 结构体（Struct）\n\n```go\n// 定义结构体\ntype Person struct {\n    Name string\n    Age  int\n    Email string\n}\n\n// 创建实例\np1 := Person{Name: "Alice", Age: 30, Email: "alice@example.com"}\np2 := Person{"Bob", 25, "bob@example.com"}  // 按顺序\np3 := new(Person)  // 返回指针\n\n// 访问字段\nfmt.Println(p1.Name)\np1.Age = 31\n\n// 匿名结构体\npoint := struct {\n    X, Y int\n}{10, 20}\n```\n\n---\n\n## 4. 函数\n\n### 4.1 基本函数\n\n```go\n// 基本函数\nfunc add(a int, b int) int {\n    return a + b\n}\n\n// 参数类型相同可简写\nfunc add(a, b int) int {\n    return a + b\n}\n\n// 多返回值\nfunc divide(a, b int) (int, error) {\n    if b == 0 {\n        return 0, errors.New("除数不能为零")\n    }\n    return a / b, nil\n}\n\n// 命名返回值\nfunc split(sum int) (x, y int) {\n    x = sum * 4 / 9\n    y = sum - x\n    return  // 裸返回\n}\n\n// 可变参数\nfunc sum(nums ...int) int {\n    total := 0\n    for _, n := range nums {\n        total += n\n    }\n    return total\n}\n```\n\n### 4.2 匿名函数和闭包\n\n```go\n// 匿名函数\nadd := func(a, b int) int {\n    return a + b\n}\nresult := add(3, 4)\n\n// 闭包\nfunc counter() func() int {\n    count := 0\n    return func() int {\n        count++\n        return count\n    }\n}\n\nc := counter()\nfmt.Println(c())  // 1\nfmt.Println(c())  // 2\nfmt.Println(c())  // 3\n```\n\n### 4.3 defer\n\n```go\nfunc example() {\n    defer fmt.Println("最后执行")\n    fmt.Println("先执行")\n}\n\n// 常用于资源清理\nfunc readFile(filename string) error {\n    file, err := os.Open(filename)\n    if err != nil {\n        return err\n    }\n    defer file.Close()  // 函数返回前自动关闭\n    \n    // 处理文件...\n    return nil\n}\n```\n\n---\n\n## 5. 方法和接口\n\n### 5.1 方法\n\n```go\ntype Rectangle struct {\n    Width, Height float64\n}\n\n// 值接收者\nfunc (r Rectangle) Area() float64 {\n    return r.Width * r.Height\n}\n\n// 指针接收者（可修改结构体）\nfunc (r *Rectangle) Scale(factor float64) {\n    r.Width *= factor\n    r.Height *= factor\n}\n\nrect := Rectangle{10, 5}\nfmt.Println(rect.Area())  // 50\nrect.Scale(2)\nfmt.Println(rect.Area())  // 200\n```\n\n### 5.2 接口\n\n```go\n// 定义接口\ntype Shape interface {\n    Area() float64\n    Perimeter() float64\n}\n\n// Rectangle 实现 Shape 接口（隐式实现）\ntype Rectangle struct {\n    Width, Height float64\n}\n\nfunc (r Rectangle) Area() float64 {\n    return r.Width * r.Height\n}\n\nfunc (r Rectangle) Perimeter() float64 {\n    return 2 * (r.Width + r.Height)\n}\n\n// Circle 也实现 Shape 接口\ntype Circle struct {\n    Radius float64\n}\n\nfunc (c Circle) Area() float64 {\n    return math.Pi * c.Radius * c.Radius\n}\n\nfunc (c Circle) Perimeter() float64 {\n    return 2 * math.Pi * c.Radius\n}\n\n// 使用接口\nfunc printShapeInfo(s Shape) {\n    fmt.Printf("面积: %.2f, 周长: %.2f\\n", s.Area(), s.Perimeter())\n}\n\nrect := Rectangle{10, 5}\ncircle := Circle{7}\nprintShapeInfo(rect)\nprintShapeInfo(circle)\n```\n\n### 5.3 空接口和类型断言\n\n```go\n// 空接口可以存储任何类型\nvar any interface{}\nany = 42\nany = "hello"\nany = []int{1, 2, 3}\n\n// 类型断言\nvalue, ok := any.(string)\nif ok {\n    fmt.Println("是字符串:", value)\n}\n\n// 类型 switch\nswitch v := any.(type) {\ncase int:\n    fmt.Println("整数:", v)\ncase string:\n    fmt.Println("字符串:", v)\ndefault:\n    fmt.Println("未知类型")\n}\n```\n\n---\n\n## 6. 并发编程\n\n### 6.1 Goroutine\n\n```go\n// 启动 goroutine\ngo func() {\n    fmt.Println("在新的 goroutine 中运行")\n}()\n\n// 带参数\ngo func(msg string) {\n    fmt.Println(msg)\n}("hello")\n\n// 等待 goroutine 完成\nvar wg sync.WaitGroup\n\nfor i := 0; i < 5; i++ {\n    wg.Add(1)\n    go func(n int) {\n        defer wg.Done()\n        fmt.Println("Worker", n)\n    }(i)\n}\n\nwg.Wait()  // 等待所有 goroutine 完成\n```\n\n### 6.2 Channel\n\n```go\n// 创建 channel\nch := make(chan int)        // 无缓冲\nch := make(chan int, 10)    // 有缓冲，容量10\n\n// 发送和接收\nch <- 42       // 发送\nvalue := <-ch  // 接收\n\n// 关闭 channel\nclose(ch)\n\n// 遍历 channel\nfor value := range ch {\n    fmt.Println(value)\n}\n\n// 示例：生产者-消费者\nfunc producer(ch chan<- int) {\n    for i := 0; i < 5; i++ {\n        ch <- i\n    }\n    close(ch)\n}\n\nfunc consumer(ch <-chan int) {\n    for value := range ch {\n        fmt.Println("收到:", value)\n    }\n}\n\nch := make(chan int)\ngo producer(ch)\nconsumer(ch)\n```\n\n### 6.3 Select\n\n```go\n// select 用于多路复用\nselect {\ncase msg1 := <-ch1:\n    fmt.Println("收到 ch1:", msg1)\ncase msg2 := <-ch2:\n    fmt.Println("收到 ch2:", msg2)\ncase ch3 <- 42:\n    fmt.Println("发送到 ch3")\ncase <-time.After(time.Second):\n    fmt.Println("超时")\ndefault:\n    fmt.Println("没有准备好的 channel")\n}\n```\n\n### 6.4 互斥锁\n\n```go\ntype SafeCounter struct {\n    mu    sync.Mutex\n    count int\n}\n\nfunc (c *SafeCounter) Increment() {\n    c.mu.Lock()\n    defer c.mu.Unlock()\n    c.count++\n}\n\nfunc (c *SafeCounter) Value() int {\n    c.mu.Lock()\n    defer c.mu.Unlock()\n    return c.count\n}\n```\n\n---\n\n## 7. 错误处理\n\n### 7.1 基本错误处理\n\n```go\nimport "errors"\n\n// 返回错误\nfunc divide(a, b float64) (float64, error) {\n    if b == 0 {\n        return 0, errors.New("除数不能为零")\n    }\n    return a / b, nil\n}\n\n// 处理错误\nresult, err := divide(10, 0)\nif err != nil {\n    fmt.Println("错误:", err)\n    return\n}\nfmt.Println("结果:", result)\n\n// 自定义错误\ntype MyError struct {\n    Code    int\n    Message string\n}\n\nfunc (e *MyError) Error() string {\n    return fmt.Sprintf("错误 %d: %s", e.Code, e.Message)\n}\n```\n\n### 7.2 panic 和 recover\n\n```go\n// panic 用于不可恢复的错误\nfunc mustPositive(n int) {\n    if n < 0 {\n        panic("数字必须为正")\n    }\n}\n\n// recover 用于捕获 panic\nfunc safeCall() {\n    defer func() {\n        if r := recover(); r != nil {\n            fmt.Println("捕获到 panic:", r)\n        }\n    }()\n    \n    panic("出错了！")\n}\n```\n\n---\n\n## 8. 包和模块\n\n### 8.1 包的组织\n\n```\nmyproject/\n├── go.mod\n├── main.go\n└── utils/\n    └── helper.go\n```\n\n```go\n// utils/helper.go\npackage utils\n\n// 大写开头 = 公开（exported）\nfunc Add(a, b int) int {\n    return a + b\n}\n\n// 小写开头 = 私有（unexported）\nfunc privateFunc() {\n    // 只能在 utils 包内使用\n}\n```\n\n```go\n// main.go\npackage main\n\nimport (\n    "fmt"\n    "myproject/utils"\n)\n\nfunc main() {\n    result := utils.Add(3, 4)\n    fmt.Println(result)\n}\n```\n\n### 8.2 Go Modules\n\n```bash\n# 初始化模块\ngo mod init myproject\n\n# 添加依赖\ngo get github.com/gin-gonic/gin\n\n# 整理依赖\ngo mod tidy\n```\n\n---\n\n## 9. 常用标准库\n\n### 9.1 fmt - 格式化 I/O\n\n```go\nfmt.Println("Hello")           // 打印并换行\nfmt.Printf("Name: %s\\n", name) // 格式化打印\nfmt.Sprintf("Age: %d", age)    // 返回格式化字符串\n\n// 常用格式化动词\n// %v  默认格式\n// %+v 带字段名的结构体\n// %#v Go 语法表示\n// %T  类型\n// %d  十进制整数\n// %s  字符串\n// %f  浮点数\n// %t  布尔值\n```\n\n### 9.2 strings - 字符串操作\n\n```go\nimport "strings"\n\nstrings.Contains("hello", "ell")     // true\nstrings.HasPrefix("hello", "he")     // true\nstrings.HasSuffix("hello", "lo")     // true\nstrings.Split("a,b,c", ",")          // ["a", "b", "c"]\nstrings.Join([]string{"a","b"}, "-") // "a-b"\nstrings.ToUpper("hello")             // "HELLO"\nstrings.TrimSpace("  hello  ")       // "hello"\nstrings.Replace("hello", "l", "L", -1) // "heLLo"\n```\n\n### 9.3 time - 时间处理\n\n```go\nimport "time"\n\nnow := time.Now()\nfmt.Println(now.Year(), now.Month(), now.Day())\n\n// 格式化（Go 使用特殊的参考时间）\nnow.Format("2006-01-02 15:04:05")\n\n// 解析\nt, _ := time.Parse("2006-01-02", "2024-03-15")\n\n// 时间计算\ntomorrow := now.Add(24 * time.Hour)\nduration := tomorrow.Sub(now)\n\n// 定时器\ntime.Sleep(2 * time.Second)\nticker := time.NewTicker(time.Second)\n```\n\n### 9.4 encoding/json - JSON 处理\n\n```go\nimport "encoding/json"\n\ntype Person struct {\n    Name string `json:"name"`\n    Age  int    `json:"age"`\n}\n\n// 序列化\np := Person{Name: "Alice", Age: 30}\ndata, _ := json.Marshal(p)\nfmt.Println(string(data))  // {"name":"Alice","age":30}\n\n// 反序列化\nvar p2 Person\njson.Unmarshal([]byte(`{"name":"Bob","age":25}`), &p2)\n```\n\n### 9.5 net/http - HTTP 服务\n\n```go\nimport "net/http"\n\n// 简单的 HTTP 服务器\nhttp.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {\n    fmt.Fprintf(w, "Hello, World!")\n})\n\nhttp.HandleFunc("/api/user", func(w http.ResponseWriter, r *http.Request) {\n    w.Header().Set("Content-Type", "application/json")\n    json.NewEncoder(w).Encode(map[string]string{"name": "Alice"})\n})\n\nhttp.ListenAndServe(":8080", nil)\n\n// HTTP 客户端\nresp, err := http.Get("https://api.example.com/data")\nif err != nil {\n    log.Fatal(err)\n}\ndefer resp.Body.Close()\nbody, _ := io.ReadAll(resp.Body)\n```\n\n---\n\n## 10. 泛型（Go 1.18+）\n\n```go\n// 泛型函数\nfunc Min[T constraints.Ordered](a, b T) T {\n    if a < b {\n        return a\n    }\n    return b\n}\n\n// 使用\nfmt.Println(Min(3, 5))       // 3\nfmt.Println(Min(3.14, 2.71)) // 2.71\nfmt.Println(Min("a", "b"))   // "a"\n\n// 泛型类型\ntype Stack[T any] struct {\n    items []T\n}\n\nfunc (s *Stack[T]) Push(item T) {\n    s.items = append(s.items, item)\n}\n\nfunc (s *Stack[T]) Pop() T {\n    n := len(s.items)\n    item := s.items[n-1]\n    s.items = s.items[:n-1]\n    return item\n}\n\n// 使用\nstack := Stack[int]{}\nstack.Push(1)\nstack.Push(2)\nfmt.Println(stack.Pop())  // 2\n```\n\n---\n\n## 总结\n\nGo 语言的核心特点：\n\n| 特性 | 说明 |\n|------|------|\n| **简洁** | 语法简单，关键字少，学习曲线平缓 |\n| **高效** | 编译速度快，运行效率高 |\n| **并发** | goroutine 和 channel 原生支持并发 |\n| **安全** | 强类型、垃圾回收、内存安全 |\n| **工具链** | 内置格式化、测试、文档等工具 |\n\n希望这份讲解对你有帮助！如果有任何具体问题，欢迎继续提问 😊'))
