2025-12-29 15:59:46.498091 Event: <class 'pydantic_ai.messages.PartEndEvent'> PartEndEvent(index=0, part=TextPart(content='# Go vs Python 异步实现对比\n\n<!DOCTYPE html>\n<html lang="zh-CN">\n<head>\n    <meta charset="UTF-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1.0">\n    <title>Go vs Python 异步实现对比</title>\n    <style>\n        body {\n            font-family: \'Segoe UI\', Tahoma, Geneva, Verdana, sans-serif;\n            line-height: 1.6;\n            color: #333;\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 20px;\n            background-color: #f5f5f5;\n        }\n        .container {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 20px;\n            margin-bottom: 30px;\n        }\n        .card {\n            flex: 1;\n            min-width: 300px;\n            background: white;\n            border-radius: 10px;\n            padding: 20px;\n            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n        }\n        h1, h2, h3 {\n            color: #2c3e50;\n        }\n        .comparison-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin: 20px 0;\n        }\n        .comparison-table th, .comparison-table td {\n            border: 1px solid #ddd;\n            padding: 12px;\n            text-align: left;\n        }\n        .comparison-table th {\n            background-color: #3498db;\n            color: white;\n        }\n        .comparison-table tr:nth-child(even) {\n            background-color: #f2f2f2;\n        }\n        .code-block {\n            background-color: #2c3e50;\n            color: #ecf0f1;\n            padding: 15px;\n            border-radius: 5px;\n            overflow-x: auto;\n            font-family: \'Courier New\', monospace;\n            margin: 15px 0;\n        }\n        .language-go {\n            border-left: 4px solid #3498db;\n        }\n        .language-python {\n            border-left: 4px solid #27ae60;\n        }\n        .feature-highlight {\n            background-color: #fff3cd;\n            padding: 10px;\n            border-radius: 5px;\n            margin: 10px 0;\n        }\n        .highlight {\n            background-color: #e3f2fd;\n            padding: 2px 4px;\n            border-radius: 3px;\n        }\n        .section-title {\n            border-bottom: 3px solid #3498db;\n            padding-bottom: 10px;\n            margin-top: 30px;\n        }\n        .conclusion {\n            background-color: #e8f5e9;\n            padding: 20px;\n            border-radius: 10px;\n            margin-top: 30px;\n        }\n        .diagram {\n            text-align: center;\n            margin: 20px 0;\n        }\n        .diagram-item {\n            display: inline-block;\n            margin: 10px;\n            padding: 15px;\n            border-radius: 8px;\n            min-width: 150px;\n            vertical-align: top;\n        }\n        .go-diagram {\n            background-color: #3498db;\n            color: white;\n        }\n        .python-diagram {\n            background-color: #27ae60;\n            color: white;\n        }\n    </style>\n</head>\n<body>\n    <h1>Go vs Python 异步实现对比</h1>\n    \n    <div class="container">\n        <div class="card">\n            <h2>Go 语言异步特性</h2>\n            <div class="feature-highlight">\n                <p><strong>核心概念：</strong>Goroutine + Channel + Context</p>\n                <p><strong>特点：</strong>轻量级并发，内置支持，高性能</p>\n            </div>\n            \n            <h3>关键组件</h3>\n            <ul>\n                <li><span class="highlight">Goroutine</span>：轻量级线程，开销极小</li>\n                <li><span class="highlight">Channel</span>：goroutine 间通信机制</li>\n                <li><span class="highlight">Context</span>：控制并发生命周期</li>\n                <li><span class="highlight">WaitGroup</span>：等待多个 goroutine 完成</li>\n            </ul>\n            \n            <h3>代码示例</h3>\n            <div class="code-block language-go">\n                package main<br>\n                <br>\n                import (<br>\n                &nbsp;&nbsp;"fmt"<br>\n                &nbsp;&nbsp;"sync"<br>\n                &nbsp;&nbsp;"time"<br>\n                )<br>\n                <br>\n                func worker(id int, jobs <-chan int, results chan<- int) {<br>\n                &nbsp;&nbsp;for j := range jobs {<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;fmt.Printf("Worker %d processing job %d\\n", id, j)<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;time.Sleep(time.Second) // 模拟耗时操作<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;results <- j * 2<br>\n                &nbsp;&nbsp;}<br>\n                }<br>\n                <br>\n                func main() {<br>\n                &nbsp;&nbsp;const numJobs = 5<br>\n                &nbsp;&nbsp;jobs := make(chan int, numJobs)<br>\n                &nbsp;&nbsp;results := make(chan int, numJobs)<br>\n                <br>\n                &nbsp;&nbsp;// 启动3个worker<br>\n                &nbsp;&nbsp;for w := 1; w <= 3; w++ {<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;go worker(w, jobs, results)<br>\n                &nbsp;&nbsp;}<br>\n                <br>\n                &nbsp;&nbsp;// 发送任务<br>\n                &nbsp;&nbsp;for j := 1; j <= numJobs; j++ {<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;jobs <- j<br>\n                &nbsp;&nbsp;}<br>\n                &nbsp;&nbsp;close(jobs)<br>\n                <br>\n                &nbsp;&nbsp;// 收集结果<br>\n                &nbsp;&nbsp;for a := 1; a <= numJobs; a++ {<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;<-results<br>\n                &nbsp;&nbsp;}<br>\n                }\n            </div>\n        </div>\n        \n        <div class="card">\n            <h2>Python 异步特性</h2>\n            <div class="feature-highlight">\n                <p><strong>核心概念：</strong>asyncio + Event Loop + Tasks</p>\n                <p><strong>特点：</strong>基于事件循环，易于理解和使用</p>\n            </div>\n            \n            <h3>关键组件</h3>\n            <ul>\n                <li><span class="highlight">async/await</span>：异步函数定义</li>\n                <li><span class="highlight">Event Loop</span>：异步事件处理</li>\n                <li><span class="highlight">Tasks</span>：异步任务包装</li>\n                <li><span class="highlight">asyncio.gather()</span>：并发执行多个协程</li>\n            </ul>\n            \n            <h3>代码示例</h3>\n            <div class="code-block language-python">\n                import asyncio<br>\n                import aiohttp<br>\n                <br>\n                async def fetch_data(url):<br>\n                &nbsp;&nbsp;async with aiohttp.ClientSession() as session:<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;async with session.get(url) as response:<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return await response.text()<br>\n                <br>\n                async def main():<br>\n                &nbsp;&nbsp;urls = [<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;\'http://httpbin.org/delay/1\',<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;\'http://httpbin.org/delay/1\',<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;\'http://httpbin.org/delay/1\'<br>\n                &nbsp;&nbsp;]<br>\n                <br>\n                &nbsp;&nbsp;# 并发执行<br>\n                &nbsp;&nbsp;tasks = [fetch_data(url) for url in urls]<br>\n                &nbsp;&nbsp;results = await asyncio.gather(*tasks)<br>\n                <br>\n                &nbsp;&nbsp;for result in results:<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;print(f"Fetched {len(result)} characters")<br>\n                <br>\n                # 运行事件循环<br>\n                asyncio.run(main())\n            </div>\n        </div>\n    </div>\n    \n    <div class="section-title">\n        <h2>详细对比分析</h2>\n    </div>\n    \n    <table class="comparison-table">\n        <thead>\n            <tr>\n                <th>对比维度</th>\n                <th>Go 语言</th>\n                <th>Python</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr>\n                <td><strong>并发模型</strong></td>\n                <td>Goroutine + Channel</td>\n                <td>asyncio + Event Loop</td>\n            </tr>\n            <tr>\n                <td><strong>调度方式</strong></td>\n                <td>M:N 调度（运行时调度）</td>\n                <td>单线程事件循环</td>\n            </tr>\n            <tr>\n                <td><strong>内存开销</strong></td>\n                <td>极低（约2KB/Goroutine）</td>\n                <td>相对较高</td>\n            </tr>\n            <tr>\n                <td><strong>性能表现</strong></td>\n                <td>高并发性能优异</td>\n                <td>适用于I/O密集型</td>\n            </tr>\n            <tr>\n                <td><strong>学习难度</strong></td>\n                <td>中等，需要理解调度机制</td>\n                <td>较低，概念直观</td>\n            </tr>\n            <tr>\n                <td><strong>适用场景</strong></td>\n                <td>高并发网络服务、微服务</td>\n                <td>Web应用、数据分析</td>\n            </tr>\n            <tr>\n                <td><strong>生态系统</strong></td>\n                <td>标准库支持强</td>\n                <td>丰富的第三方库</td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <div class="section-title">\n        <h2>架构图示</h2>\n    </div>\n    \n    <div class="diagram">\n        <div class="diagram-item go-diagram">\n            <h3>Go 异步架构</h3>\n            <p><strong>Goroutine</strong></p>\n            <p><strong>Channel</strong></p>\n            <p><strong>Runtime</strong></p>\n            <p><strong>轻量级并发</strong></p>\n        </div>\n        <div class="diagram-item python-diagram">\n            <h3>Python 异步架构</h3>\n            <p><strong>async/await</strong></p>\n            <p><strong>Event Loop</strong></p>\n            <p><strong>Tasks</strong></p>\n            <p><strong>协程驱动</strong></p>\n        </div>\n    </div>\n    \n    <div class="section-title">\n        <h2>最佳实践对比</h2>\n    </div>\n    \n    <div class="container">\n        <div class="card">\n            <h3>Go 最佳实践</h3>\n            <ul>\n                <li>使用 Worker Pool 模式管理并发</li>\n                <li>合理使用 Context 控制超时和取消</li>\n                <li>避免共享内存，使用 Channel 通信</li>\n                <li>使用 WaitGroup 等待任务完成</li>\n            </ul>\n            \n            <div class="code-block language-go">\n                // Worker Pool 模式<br>\n                func workerPool(jobs <-chan Job, results chan<- Result, numWorkers int) {<br>\n                &nbsp;&nbsp;var wg sync.WaitGroup<br>\n                &nbsp;&nbsp;for i := 0; i < numWorkers; i++ {<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;wg.Add(1)<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;go func() {<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;defer wg.Done()<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;for job := range jobs {<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;// 处理任务<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;results <- process(job)<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;}<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;}()<br>\n                &nbsp;&nbsp;}<br>\n                &nbsp;&nbsp;wg.Wait()<br>\n                }\n            </div>\n        </div>\n        \n        <div class="card">\n            <h3>Python 最佳实践</h3>\n            <ul>\n                <li>使用 asyncio.Semaphore 控制并发数量</li>\n                <li>合理使用 asyncio.gather() 并发执行</li>\n                <li>利用异步上下文管理器</li>\n                <li>结合 aiohttp 等异步库</li>\n            </ul>\n            \n            <div class="code-block language-python">\n                # 控制并发数<br>\n                semaphore = asyncio.Semaphore(10)  # 最多10个并发<br>\n                <br>\n                async def limited_fetch(session, url):<br>\n                &nbsp;&nbsp;async with semaphore:<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;async with session.get(url) as response:<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return await response.text()<br>\n                <br>\n                # 处理完成的任务<br>\n                async def process_urls(urls):<br>\n                &nbsp;&nbsp;async with aiohttp.ClientSession() as session:<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;tasks = [limited_fetch(session, url) for url in urls]<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;for coro in asyncio.as_completed(tasks):<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;result = await coro<br>\n                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;print(f"Completed: {result}")\n            </div>\n        </div>\n    </div>\n    \n    <div class="conclusion">\n        <h2>总结与建议</h2>\n        <p><strong>Go 语言更适合：</strong></p>\n        <ul>\n            <li>需要极高并发性能的场景</li>\n            <li>微服务架构和分布式系统</li>\n            <li>实时系统和高吞吐量应用</li>\n            <li>对内存开销敏感的应用</li>\n        </ul>\n        \n        <p><strong>Python 语言更适合：</strong></p>\n        <ul>\n            <li>快速原型开发和实验</li>\n            <li>Web 应用和 API 服务</li>\n            <li>数据处理和科学计算</li>\n            <li>已有同步代码需要异步改造</li>\n        </ul>\n        \n        <p>选择哪种语言的异步实现主要取决于项目的具体需求、团队的技术栈以及性能要求。</p>\n    </div>\n</body>\n</html>'))
