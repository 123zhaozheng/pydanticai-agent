t(df[\'交易时间\'], df[\'累计收益率\']*100, color=\'purple\')\\nplt.title(\'累计收益率\')\\nplt.xlabel(\'交易时间\')\\nplt.ylabel(\'累计收益率 (%)\')\\nplt.xticks(rotation=45)\\nplt.grid(True, alpha=0.3)\\nplt.tight_layout()\\nplt.savefig(\'/workspace/intermediate/stock_cumulative_return.png\', dpi=300, bbox_inches=\'tight\')\\nplt.close()\\n\\nprint(\\"累计收益率图表已保存至 /workspace/intermediate/stock_cumulative_return.png\\")\\n\\n# 计算波动率\\ndf[\'波动率\'] = df[\'收益率\'].rolling(window=10).std()\\n\\n# 绘制波动率图\\nplt.figure(figsize=(12, 6))\\nplt.plot(df[\'交易时间\'], df[\'波动率\'], color=\'red\')\\nplt.title(\'10日滚动波动率\')\\nplt.xlabel(\'交易时间\')\\nplt.ylabel(\'波动率\')\\nplt.xticks(rotation=45)\\nplt.grid(True, alpha=0.3)\\nplt.tight_layout()\\nplt.savefig(\'/workspace/intermediate/stock_volatility.png\', dpi=300, bbox_inches=\'tight\')\\nplt.close()\\n\\nprint(\\"波动率图表已保存至 /workspace/intermediate/stock_volatility.png\\")\\n\\n# 保存分析结果到CSV文件\\ndf.to_csv(\'/workspace/intermediate/stock_analysis_results.csv\', index=False, encoding=\'utf-8-sig\')\\nprint(\\"详细分析结果已保存至 /workspace/intermediate/stock_analysis_results.csv\\")\\n\\nprint(\\"\\\\n=== 分析完成 ===\\")"}', tool_call_id='call_163c1439ba79429e8f3d05d4'))
